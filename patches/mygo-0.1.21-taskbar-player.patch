+
+func TestTaskbarNativeRectangleLayout(t *testing.T) {
+	// IUIAutomationElement::get_CachedBoundingRectangle writes a Windows
+	// RECT (four LONGs), not four doubles or Go architecture-sized ints.
+	var r taskbarRect
+	if unsafe.Sizeof(r) != 16 || unsafe.Offsetof(r.Right) != 8 || unsafe.Offsetof(r.Bottom) != 12 {
+		t.Fatal("rectangle does not match the Win32 RECT ABI")
+	}
+}
+
+func TestTaskbarOcclusionRespectsOverlayAndZOrder(t *testing.T) {
+	bar := taskbarRect{0, 1552, 2560, 1600}
+	full := taskbarRect{0, 0, 2560, 1600}
+	widget := taskbarRect{10, 1556, 398, 1596}
+	for _, tc := range []struct {
+		name                string
+		rect                taskbarRect
+		style               uintptr
+		above, active, want bool
+	}{
+		{"transparent HUD", full, 0x20, true, false, false},
+		{"inactive large overlay", full, 0x08000000, true, false, false},
+		{"foreground fullscreen", full, 0, true, true, true},
+		{"other music widget", widget, 0x08000000, true, false, true},
+		{"click-through lyrics widget", widget, 0x08000020, true, false, true},
+		{"widget behind taskbar", widget, 0x08000000, false, false, false},
+		{"maximized resize border", taskbarRect{0, 0, 2560, 1559}, 0, true, true, false},
+	} {
+		if got := taskbarWindowOccludes(bar, tc.rect, tc.style, tc.above, tc.active); got != tc.want {
+			t.Errorf("%s: got %v want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+// Opt-in read-only integration diagnostic. It creates no window, performs no
+// input, and prints only classes, styles and geometry (never window titles).
+func TestTaskbarReadOnlyProbe(t *testing.T) {
+	if os.Getenv("MYGO_TASKBAR_PROBE") != "1" {
+		t.Skip("set MYGO_TASKBAR_PROBE=1 for live taskbar geometry")
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	p := newTaskbarProbe()
+	if p == nil {
+		t.Fatal("UI Automation initialization failed")
+	}
+	defer p.close()
+	foreground, _, _ := taskbarForeground.Call()
+	for _, w := range taskbarSnapshotWindows() {
+		t.Logf("class=%q rect=%+v exStyle=%#x foreground=%v", w.class, w.rect, w.exStyle, w.hwnd == foreground)
+		if w.class == "MyGoWindow" && w.rect.height() <= 120 {
+			// BORDER_COLOR is set-only; its getter returns E_INVALIDARG.
+			var corner uint32
+			cornerHR, _, _ := taskbarGetDWMAttribute.Call(w.hwnd, 33, uintptr(unsafe.Pointer(&corner)), 4)
+			t.Logf("taskbar DWM corner=%d HRESULT=%#x", corner, uint32(cornerHR))
+		}
+		if w.class == "Shell_TrayWnd" || w.class == "Shell_SecondaryTrayWnd" {
+			rects, ok := p.occupied(w.hwnd)
+			dpi, _, _ := taskbarGetDPI.Call(w.hwnd)
+			t.Logf("taskbar dpi=%d UIA=%v occupied=%v", dpi, ok, rects)
+		}
+	}
+	r, ok := p.place(0)
+	t.Logf("placement available=%v rect=%+v", ok, r)
+}
