+package app
+
+import (
+	"errors"
+	"testing"
+
+	"mygo-music/internal/music"
+)
+
+// A completed heart click must not overwrite the next listener's heart or library.
+func TestLikeCompletionStaysWithItsListener(t *testing.T) {
+	for _, refused := range []bool{false, true} {
+		name := "accepted"
+		if refused {
+			name = "refused"
+		}
+		t.Run(name, func(t *testing.T) {
+			a := newTestApp()
+			ch := posts(a)
+			fake(a).like = func(string, bool) error {
+				if refused {
+					return errors.New("offline")
+				}
+				return nil
+			}
+			a.account = &music.Account{ID: "previous-listener"}
+			a.toggleLike(&music.Track{ID: "3"})
+			a.account = &music.Account{ID: "current-listener"}
+			a.liked = map[string]bool{"3": refused}
+			a.likedList = nil
+			a.toast = ""
+			runPost(t, ch)
+			if a.liked["3"] != refused || len(a.likedList) != 0 || a.toast != "" {
+				t.Fatal("the previous listener's response changed the current listener")
+			}
+		})
+	}
+}
