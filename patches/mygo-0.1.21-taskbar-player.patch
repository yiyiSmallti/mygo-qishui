+package app
+
+// The taskbar player is a separate, non-activating window in unused taskbar
+// space. Its controls drive the same player and queue as the main view.
+type taskbarControls interface {
+	sync()
+	close()
+}
+
+func (a *app) syncTaskbar() {
+	if a.taskbar != nil {
+		a.taskbar.sync()
+	}
+}
+
+func (a *app) closeTaskbar() {
+	if a.taskbar != nil {
+		a.taskbar.close()
+		a.taskbar = nil
+	}
