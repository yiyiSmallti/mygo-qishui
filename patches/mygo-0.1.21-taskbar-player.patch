+package app
+
+import (
+	"math"
+	"sort"
+)
+
+// All geometry is in physical desktop pixels. Do not scale global X/Y by a
+// monitor's DPI: monitors with different scales do not share one DIP origin.
+type taskbarRect struct{ Left, Top, Right, Bottom int32 }
+
+func (r taskbarRect) width() int32  { return r.Right - r.Left }
+func (r taskbarRect) height() int32 { return r.Bottom - r.Top }
+func (r taskbarRect) valid() bool   { return r.width() > 0 && r.height() > 0 }
+func (r taskbarRect) overlaps(s taskbarRect) bool {
+	return r.Left < s.Right && s.Left < r.Right && r.Top < s.Bottom && s.Top < r.Bottom
+}
+
+// taskbarPlacement subtracts occupied controls and other widgets before
+// choosing a size. Unknown geometry never authorizes covering taskbar buttons.
+func taskbarPlacement(bar taskbarRect, occupied []taskbarRect, dpi uint32) (taskbarRect, bool) {
+	if !bar.valid() || bar.height() > bar.width() || dpi < 48 || dpi > 768 {
+		return taskbarRect{}, false
+	}
+	px := func(dip int) int32 { return int32(math.Ceil(float64(dip) * float64(dpi) / 96)) }
+	if bar.height() < px(28) { // auto-hidden taskbars may expose only a thin edge
+		return taskbarRect{}, false
+	}
+	margin := px(6)
+	type span struct{ left, right int32 }
+	spans := []span{{bar.Left, bar.Left + px(12)}, {bar.Right - px(12), bar.Right}}
+	for _, r := range occupied {
+		if r.valid() && r.overlaps(bar) {
+			spans = append(spans, span{max(bar.Left, r.Left-margin), min(bar.Right, r.Right+margin)})
+		}
+	}
+	sort.Slice(spans, func(i, j int) bool { return spans[i].left < spans[j].left })
+	var gaps []span
+	left := bar.Left
+	for _, s := range spans {
+		if s.left > left {
+			gaps = append(gaps, span{left, s.left})
+		}
+		left = max(left, s.right)
+	}
+	if left < bar.Right {
+		gaps = append(gaps, span{left, bar.Right})
+	}
+	// Prefer a full strip, then the compact strip, then cover/play/next.
+	// Within each size prefer the leftmost safe space.
+	for _, width := range []int{388, 248, 108} {
+		for _, gap := range gaps {
+			if gap.right-gap.left >= px(width) {
+				h := min(px(40), bar.height())
+				top := bar.Top + (bar.height()-h)/2
+				return taskbarRect{gap.left, top, gap.left + px(width), top + h}, true
+			}
+		}
+	}
+	return taskbarRect{}, false
+}
