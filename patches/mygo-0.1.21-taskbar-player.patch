+//go:build windows
+
+package app
+
+import (
+	"runtime"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// UIAutomationClient.h from the Windows SDK defines these COM methods. Only
+// cached control types, visibility and bounding rectangles are requested: no
+// labels, window text, account state, invocation patterns or input injection.
+type taskbarCOM struct{ vtable *[85]uintptr }
+
+//go:uintptrescapes
+func (o *taskbarCOM) call(method int, args ...uintptr) uintptr {
+	r, _, _ := syscall.SyscallN(o.vtable[method], append([]uintptr{uintptr(unsafe.Pointer(o))}, args...)...)
+	runtime.KeepAlive(o)
+	return r
+}
+func (o *taskbarCOM) release() {
+	if o != nil {
+		o.call(2)
+	}
+}
+func taskbarFailed(hr uintptr) bool { return int32(hr) < 0 }
+
+var (
+	taskbarOle32          = windows.NewLazySystemDLL("ole32.dll")
+	taskbarCoInitialize   = taskbarOle32.NewProc("CoInitializeEx")
+	taskbarCoUninitialize = taskbarOle32.NewProc("CoUninitialize")
+	taskbarCoCreate       = taskbarOle32.NewProc("CoCreateInstance")
+	taskbarEnumCallback   = syscall.NewCallback(taskbarCollectWindow)
+)
+
+type taskbarProbe struct {
+	automation, condition, cache *taskbarCOM
+	previousDPI                  uintptr
+}
+
+func newTaskbarProbe() *taskbarProbe {
+	hr, _, _ := taskbarCoInitialize.Call(0, 0) // COINIT_MULTITHREADED
+	if taskbarFailed(hr) {
+		return nil
+	}
+	p := &taskbarProbe{}
+	// The app is PMv2, but a diagnostic/test host may not be. Keep HWND,
+	// UIA and monitor coordinates in physical pixels on this worker too.
+	if taskbarSetThreadDPI.Find() == nil {
+		p.previousDPI, _, _ = taskbarSetThreadDPI.Call(^uintptr(3))
+	}
+	clsid, _ := windows.GUIDFromString("{E22AD333-B25F-460C-83D0-0581107395C9}") // CUIAutomation8
+	iid, _ := windows.GUIDFromString("{34723AFF-0C9D-49D0-9896-7AB52DF8CD8A}")   // IUIAutomation2
+	hr, _, _ = taskbarCoCreate.Call(uintptr(unsafe.Pointer(&clsid)), 0, 1, uintptr(unsafe.Pointer(&iid)), uintptr(unsafe.Pointer(&p.automation)))
+	if taskbarFailed(hr) || p.automation == nil {
+		p.close()
+		return nil
+	}
+	// Bound each provider transaction; Explorer being hung cannot block the
+	// app's event loop, and cannot leave a long-lived stale placement.
+	p.automation.call(61, 750) // put_ConnectionTimeout
+	p.automation.call(63, 750) // put_TransactionTimeout
+	if taskbarFailed(p.automation.call(21, uintptr(unsafe.Pointer(&p.condition)))) ||
+		taskbarFailed(p.automation.call(20, uintptr(unsafe.Pointer(&p.cache)))) {
+		p.close()
+		return nil
+	}
+	for _, property := range []uintptr{30001, 30003, 30022} { // rect, type, offscreen
+		if taskbarFailed(p.cache.call(3, property)) {
+			p.close()
+			return nil
+		}
+	}
+	return p
+}
+
+func (p *taskbarProbe) close() {
+	p.cache.release()
+	p.condition.release()
+	p.automation.release()
+	if p.previousDPI != 0 {
+		taskbarSetThreadDPI.Call(p.previousDPI)
+	}
+	taskbarCoUninitialize.Call()
+}
+
+func (p *taskbarProbe) occupied(hwnd uintptr) ([]taskbarRect, bool) {
+	var root, list *taskbarCOM
+	if taskbarFailed(p.automation.call(6, hwnd, uintptr(unsafe.Pointer(&root)))) || root == nil {
+		return nil, false
+	}
+	defer root.release()
+	// Fetch all relevant properties in one cross-process operation, instead
+	// of querying every button individually once a second.
+	if taskbarFailed(root.call(8, 4, uintptr(unsafe.Pointer(p.condition)), uintptr(unsafe.Pointer(p.cache)), uintptr(unsafe.Pointer(&list)))) || list == nil {
+		return nil, false
+	}
+	defer list.release()
+	var length int32
+	if taskbarFailed(list.call(3, uintptr(unsafe.Pointer(&length)))) || length < 1 || length > 2048 {
+		return nil, false
+	}
+	var rects []taskbarRect
+	buttons := 0
+	for i := int32(0); i < length; i++ {
+		var element *taskbarCOM
+		if taskbarFailed(list.call(4, uintptr(i), uintptr(unsafe.Pointer(&element)))) || element == nil {
+			return nil, false
+		}
+		var kind, offscreen int32
+		var rect taskbarRect
+		ok := !taskbarFailed(element.call(53, uintptr(unsafe.Pointer(&kind)))) &&
+			!taskbarFailed(element.call(70, uintptr(unsafe.Pointer(&offscreen)))) &&
+			!taskbarFailed(element.call(75, uintptr(unsafe.Pointer(&rect))))
+		element.release()
+		if !ok {
+			return nil, false
+		}
+		if offscreen != 0 || !rect.valid() {
+			continue
+		}
+		// Containers span unused space too. Their visible contents reserve
+		// space; the taskbar root, list, toolbar and XAML panes do not.
+		switch kind {
+		case 50000, 50002, 50003, 50004, 50005, 50006, 50007, 50011, 50012, 50013, 50014, 50015, 50016, 50019, 50020, 50031:
+			rects = append(rects, rect)
+			if kind == 50000 || kind == 50007 {
+				buttons++
+			}
+		}
+	}
+	// If Windows does not expose taskbar buttons, do not guess free space.
+	return rects, buttons > 0
+}
+
+type taskbarNativeWindow struct {
+	hwnd, rootOwner uintptr
+	exStyle         uintptr
+	class           string
+	rect            taskbarRect
+}
+
+func taskbarCollectWindow(hwnd, context uintptr) uintptr {
+	if !taskbarWindowShown(hwnd) {
+		return 1
+	}
+	rect, ok := taskbarWindowRect(hwnd)
+	if !ok {
+		return 1
+	}
+	exStyle, _, _ := taskbarGetLong.Call(hwnd, ^uintptr(19))
+	if exStyle&0x80000 != 0 { // a wholly transparent layered window is not occupied space
+		var key, flags uint32
+		var alpha byte
+		ok, _, _ := taskbarLayeredAttributes.Call(hwnd, uintptr(unsafe.Pointer(&key)), uintptr(unsafe.Pointer(&alpha)), uintptr(unsafe.Pointer(&flags)))
+		if ok != 0 && flags&2 != 0 && alpha == 0 {
+			return 1
+		}
+	}
+	owner, _, _ := taskbarAncestor.Call(hwnd, 3) // GA_ROOTOWNER
+	list := (*[]taskbarNativeWindow)(unsafe.Pointer(context))
+	*list = append(*list, taskbarNativeWindow{hwnd: hwnd, rootOwner: owner, exStyle: exStyle, class: taskbarWindowClass(hwnd), rect: rect})
+	return 1
+}
+
+func taskbarSnapshotWindows() []taskbarNativeWindow {
+	var list []taskbarNativeWindow
+	taskbarEnumWindows.Call(taskbarEnumCallback, uintptr(unsafe.Pointer(&list)))
+	runtime.KeepAlive(list)
+	return list
+}
+
+func taskbarVisibleRect(hwnd uintptr, rect taskbarRect) (taskbarRect, bool) {
+	monitor, _, _ := taskbarMonitorFromWindow.Call(hwnd, 0)
+	if monitor == 0 {
+		return taskbarRect{}, false
+	}
+	var info struct {
+		Size          uint32
+		Monitor, Work taskbarRect
+		Flags         uint32
+	}
+	info.Size = uint32(unsafe.Sizeof(info))
+	ok, _, _ := taskbarGetMonitorInfo.Call(monitor, uintptr(unsafe.Pointer(&info)))
+	if ok == 0 {
+		return taskbarRect{}, false
+	}
+	// Clipping detects auto-hide even though Explorer retains a full-height
+	// HWND just outside the monitor. Never pin our panel over an auto-hide edge.
+	r := taskbarRect{max(rect.Left, info.Monitor.Left), max(rect.Top, info.Monitor.Top), min(rect.Right, info.Monitor.Right), min(rect.Bottom, info.Monitor.Bottom)}
+	return r, r.valid()
+}
+
+func (p *taskbarProbe) place(own uintptr) (taskbarRect, bool) {
+	windows := taskbarSnapshotWindows()
+	foreground, _, _ := taskbarForeground.Call()
+	foregroundRoot, _, _ := taskbarAncestor.Call(foreground, 3)
+	// Prefer the primary taskbar. A secondary display is a safe fallback
+	// when the primary has no space; each uses its own physical pixel DPI.
+	for _, class := range []string{"Shell_TrayWnd", "Shell_SecondaryTrayWnd"} {
+		for barIndex, bar := range windows {
+			if bar.class != class {
+				continue
+			}
+			rect, ok := taskbarVisibleRect(bar.hwnd, bar.rect)
+			if !ok {
+				continue
+			}
+			dpi, _, _ := taskbarGetDPI.Call(bar.hwnd)
+			if dpi == 0 {
+				continue
+			}
+			occupied, ok := p.occupied(bar.hwnd)
+			if !ok {
+				continue
+			}
+			for otherIndex, other := range windows {
+				if other.hwnd == own || other.hwnd == bar.hwnd {
+					continue
+				}
+				switch other.class {
+				case "Progman", "WorkerW", "Shell_TrayWnd", "Shell_SecondaryTrayWnd":
+					continue
+				}
+				active := other.hwnd == foreground || foregroundRoot != 0 && other.rootOwner == foregroundRoot
+				if taskbarWindowOccludes(rect, other.rect, other.exStyle, otherIndex < barIndex, active) {
+					occupied = append(occupied, other.rect)
+				}
+			}
+			if result, ok := taskbarPlacement(rect, occupied, uint32(dpi)); ok {
+				return result, true
+			}
+		}
+	}
+	return taskbarRect{}, false
+}
+
+// Large non-activating overlays (GPU telemetry, input surfaces, etc.) may have
+// monitor-sized HWNDs despite drawing no content at the taskbar. Do not treat
+// their rectangle alone as a full-screen app. A foreground window is different;
+// compact widgets and ordinary popups count when above the taskbar in Z order.
+func taskbarWindowOccludes(bar, other taskbarRect, exStyle uintptr, above, active bool) bool {
+	if !other.overlaps(bar) {
+		return false
+	}
+	overlap := min(other.Bottom, bar.Bottom) - max(other.Top, bar.Top)
+	if overlap <= bar.height()/4 {
+		return false
+	}
+	if active {
+		return true
+	}
+	if !above {
+		return false
+	}
+	if other.height() <= bar.height()*3 {
+		return true
+	}
+	// TRANSPARENT affects drawing/hit-testing, not whether content exists:
+	// a compact click-through lyrics widget still reserves its visible area.
+	return exStyle&(0x08000000|0x20) == 0 // NOACTIVATE / TRANSPARENT large overlays
+}
