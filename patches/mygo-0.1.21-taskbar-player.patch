+// Explicit reload actions fetch a fresh page on a second click; ordinary
+// navigation remains cached, and the first click never sends two requests.
+func TestBrowseLinkReloadAndCache(t *testing.T) {
+	for _, reload := range []bool{false, true} {
+		for _, cover := range []string{"", "cover:0"} {
+			t.Run(fmt.Sprintf("reload=%v/cover=%v", reload, cover != ""), func(t *testing.T) {
+				a, ch, asked := browseApp()
+				framesTracks(a)
+				a.home = &music.Browse{Sections: []music.Section{{Links: []music.Link{{Title: "Open picks", Page: "picks", ImageURL: cover, Reload: reload}}}}}
+				tt := ui.NewTester(a.view, 1180, 780)
+				tt.Frame()
+				if err := tt.Click("Open picks"); err != nil {
+					t.Fatal(err)
+				}
+				if got := wait(t, asked, "the first page"); got != "picks" {
+					t.Fatalf("asked %q", got)
+				}
+				runPost(t, ch)
+				if len(asked) != 0 {
+					t.Fatal("the first click sent a duplicate request")
+				}
+				tt.Key(0, ui.KeyBack)
+				tt.Frame()
+				if err := tt.Click("Open picks"); err != nil {
+					t.Fatal(err)
+				}
+				if a.route.id != "picks" || a.route.page != pageBrowse {
+					t.Fatalf("opened %+v", a.route)
+				}
+				if a.browses["picks"].loading != reload {
+					t.Fatalf("reload=%v loading=%v", reload, a.browses["picks"].loading)
+				}
+				if reload {
+					if got := wait(t, asked, "fresh picks"); got != "picks" {
+						t.Fatalf("asked %q", got)
+					}
+					runPost(t, ch)
+				}
+				if len(asked) != 0 {
+					t.Fatal("navigation sent an extra request")
+				}
+			})
+		}
+	}
+}
+
+// Replacing a cover with an action row preserves Tab/Enter navigation at
+// narrow widths, including a link whose description is much longer than it.
+func TestBrowseActionKeyboardNavigation(t *testing.T) {
+	a, ch, asked := browseApp()
+	link := music.Link{Title: "Library", Subtitle: "All saved music, followed artists, albums and recent listening", Page: "library"}
+	tt := ui.NewTester(func(c *ui.Context) {
+		a.pal = paletteFor(c.Theme())
+		ui.Column(c).Padding(12).Children(func() { a.browseAction(c, &link) })
+	}, 320, 120)
+	tt.Frame()
+	tt.Key(0, ui.KeyTab)
+	if !tt.Focused("Library") {
+		t.Fatal("Tab could not focus the action")
+	}
+	tt.Key(0, ui.KeyEnter)
+	if a.route.page != pageBrowse || a.route.id != "library" {
+		t.Fatalf("Enter opened %+v", a.route)
+	}
+	if wait(t, asked, "the library") != "library" {
+		t.Fatal("the wrong page was requested")
+	}
+	runPost(t, ch)
+}
+
+// Compact station shortcuts keep the same continuous radio feed for pointer
+// and keyboard activation; sizing the card must not turn it into plain browse.
+func TestCompactStationStartsRadio(t *testing.T) {
+	for _, keyboard := range []bool{false, true} {
+		t.Run(fmt.Sprintf("keyboard=%v", keyboard), func(t *testing.T) {
+			a, ch := radioApp()
+			st := a.stations[0]
+			asked := make(chan string, 8)
+			fake(a).stationNext = func(id string) ([]music.Track, error) {
+				asked <- id
+				return sourced(song("one", "One"), song("two", "Two"), song("three", "Three"), song("four", "Four"), song("five", "Five")), nil
+			}
+			tt := ui.NewTester(func(c *ui.Context) {
+				a.pal = paletteFor(c.Theme())
+				ui.Column(c).Padding(12).Children(func() { a.compactStationCard(c, &st) })
+			}, 320, 120)
+			if !keyboard {
+				// A narrow page wraps the third shortcut onto another list row;
+				// its click must still select that station, not the first one.
+				a.route = route{page: pageHome, src: "fake"}
+				a.home = &music.Browse{Sections: []music.Section{{Layout: "compact", Stations: []music.Station{
+					{ID: "other-one", Name: "Other one"}, {ID: "other-two", Name: "Other two"}, st,
+				}}}}
+				tt = ui.NewTester(a.view, 780, 900)
+			}
+			tt.Frame()
+			if keyboard {
+				tt.Key(0, ui.KeyTab)
+				tt.Key(0, ui.KeyEnter)
+			} else if err := tt.Click(st.Name); err != nil {
+				t.Fatal(err)
+			}
+			if id := wait(t, asked, "station feed"); id != st.ID {
+				t.Fatalf("requested station %q", id)
+			}
+			until(t, ch, func() bool { return a.pl.Radio() != "" })
+			if a.pl.Radio() != radioName("fake", &st) || a.pl.Current() == nil || a.pl.Current().ID != "one" {
+				t.Fatalf("radio %q current=%+v", a.pl.Radio(), a.pl.Current())
+			}
+		})
+	}
+}
