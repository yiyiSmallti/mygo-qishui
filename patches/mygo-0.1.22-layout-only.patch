+// browseAction is an action/navigation entry without artwork. It stays short
+// and keyboard-focusable rather than pretending to be an empty album cover.
+func (a *app) browseAction(c *ui.Context, link *music.Link) {
+	p := a.pal
+	height := float32(48)
+	if link.Subtitle != "" {
+		height = 64
+	}
+	b := ui.ButtonBase(c).Row().Height(height).Padding(10, 16).Gap(14).
+		AlignItems(ui.Center).Radius(10).Label(link.Title).FocusRingColor(p.accent)
+	b.Background(p.hover)
+	if b.Hovered() || b.Pressed() {
+		b.Background(p.press)
+	}
+	b.Children(func() {
+		ui.Column(c).Grow(1).Shrink(1).MinWidth(0).Gap(3).Children(func() {
+			ui.Text(c, link.Title).FontSize(13.5).FontWeight(600).TextColor(p.text).SingleLine()
+			if link.Subtitle != "" {
+				ui.Text(c, link.Subtitle).FontSize(12).TextColor(p.muted).SingleLine()
+			}
+		})
+		icon := iconForward
+		if link.Reload {
+			icon = iconRefresh
+		}
+		ui.Icon(c, icon).Size(17, 17).Shrink(0).TextColor(p.muted)
+	})
+	if b.Clicked() {
+		a.openBrowseLink(link)
+	}
 }
 
