diff --git a/internal/app/ui_listening_modes.go b/internal/app/ui_listening_modes.go
new file mode 100644
index 0000000..cfbfbb4
--- /dev/null
+++ b/internal/app/ui_listening_modes.go
@@ -0,0 +1,73 @@
+package app
+
+import (
+	"github.com/egoist/mygo/ui"
+
+	"mygo-music/internal/music"
+)
+
+// modeStationButton gives common modes one large target with a source-supplied
+// monochrome icon; transparent white artwork follows both application themes.
+func (a *app) modeStationButton(c *ui.Context, st *music.Station) {
+	p := a.pal
+	b := ui.ButtonBase(c).Row().Height(72).Padding(14, 18).Gap(12).AlignItems(ui.Center).
+		Radius(14).Label(st.Name).FocusRingColor(p.accent).Background(p.hover)
+	if b.Hovered() || b.Pressed() {
+		b.Background(p.press)
+	}
+	b.Children(func() {
+		bmp := bitmap(a.art.get(sized(st.IconURL, 96), false))
+		icon := ui.Box(c).Size(30, 30).Shrink(0).Center()
+		if bmp == nil {
+			icon.Children(func() { ui.Icon(c, iconRadio).Size(27, 27).TextColor(p.text) })
+		} else {
+			icon.Draw(func(painter *ui.Painter, r ui.Rect) {
+				w, h := bmp.Size()
+				if w <= 0 || h <= 0 {
+					return
+				}
+				scale := min(r.W/float32(w), r.H/float32(h))
+				dst := ui.Rect{X: r.X + (r.W-float32(w)*scale)/2, Y: r.Y + (r.H-float32(h)*scale)/2, W: float32(w) * scale, H: float32(h) * scale}
+				painter.ImageRegion(bmp, ui.Rect{}, dst, ui.ImageOptions{Tint: p.text})
+			})
+		}
+		ui.Column(c).Grow(1).Shrink(1).MinWidth(0).Gap(3).Children(func() {
+			ui.Text(c, st.Name).FontSize(16).FontWeight(600).TextColor(p.text).SingleLine()
+			if st.Description != "" {
+				ui.Text(c, st.Description).FontSize(12.5).TextColor(p.muted).SingleLine()
+			}
+		})
+	})
+	if b.Clicked() {
+		a.playStation(a.library, st)
+	}
+}
+
+// modeStationCover keeps exploration artwork and its description together in
+// a landscape radio button. The lower scrim preserves readable white copy.
+func (a *app) modeStationCover(c *ui.Context, st *music.Station) {
+	p := a.pal
+	b := ui.ButtonBase(c).AspectRatio(1.5).MinHeight(140).MaxHeight(230).Radius(14).
+		Label(st.Name).FocusRingColor(p.accent).Background(p.hover)
+	b.Children(func() {
+		a.coverFill(c, st.ImageURL, 600, 14)
+		ui.Box(c).Absolute().Top(0).Left(0).Right(0).Bottom(0).Radius(14).PassThrough().
+			LinearGradient(ui.LinearGradient{Angle: 180, Stops: []ui.GradientStop{
+				{Color: ui.RGBA(0, 0, 0, 0.05), At: 0},
+				{Color: ui.RGBA(0, 0, 0, 0.12), At: 0.3},
+				{Color: ui.RGBA(0, 0, 0, 0.7), At: 1},
+			}})
+		ui.Column(c).Absolute().Left(14).Right(14).Bottom(14).Gap(4).PassThrough().Children(func() {
+			ui.Text(c, st.Name).FontSize(18).FontWeight(700).TextColor(white).MaxLines(2).LineHeight(1.2)
+			if st.Description != "" {
+				ui.Text(c, st.Description).FontSize(13.5).TextColor(white.Alpha(0.86)).MaxLines(2).LineHeight(1.35)
+			}
+		})
+		if b.Hovered() || b.Pressed() {
+			ui.Box(c).Absolute().Top(0).Left(0).Right(0).Bottom(0).Radius(14).PassThrough().Background(white.Alpha(0.06))
+		}
+	})
+	if b.Clicked() {
+		a.playStation(a.library, st)
+	}
+}
