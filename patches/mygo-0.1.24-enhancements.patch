+package app
+
+// The taskbar player is a separate, non-activating window in unused taskbar
+// space. Its controls drive the same player and queue as the main view.
+type taskbarControls interface {
+	sync()
+	close()
+}
+
+// Dragging only changes the taskbar panel's preferred safe slot, never the
+// player queue. Platforms without this panel can leave the interface absent.
+type taskbarDragControls interface {
+	beginDrag()
+	updateDrag()
+	endDrag()
+	cancelDrag()
+}
+
+func (a *app) beginTaskbarDrag() {
+	if panel, ok := a.taskbar.(taskbarDragControls); ok {
+		panel.beginDrag()
+	}
+}
+
+// Preserve the accumulated DIP move if the first delivered event is already
+// outside this small window, so dragging anchors at the original press.
+func (a *app) beginTaskbarDragFrom(deltaX float32) {
+	if panel, ok := a.taskbar.(interface{ beginDragFrom(float32) }); ok {
+		panel.beginDragFrom(deltaX)
+		return
+	}
+	a.beginTaskbarDrag()
+}
+
+func (a *app) updateTaskbarDrag() {
+	if panel, ok := a.taskbar.(taskbarDragControls); ok {
+		panel.updateDrag()
+	}
+}
+
+func (a *app) endTaskbarDrag() {
+	if panel, ok := a.taskbar.(taskbarDragControls); ok {
+		panel.endDrag()
+	}
+}
+
+func (a *app) cancelTaskbarDrag() {
+	if panel, ok := a.taskbar.(taskbarDragControls); ok {
+		panel.cancelDrag()
+	}
+}
+
+// The small close control hides this panel until it is enabled in Settings;
+// unlike closeTaskbar at shutdown, it does not destroy the player or window.
+func (a *app) dismissTaskbarWidget() {
+	a.settings.TaskbarPlayer = false
+	a.settings.save()
+	a.syncTaskbar()
+	a.redraw()
+}
+
+func (a *app) setTaskbarSide(side string) {
+	side = normalizedTaskbarSide(side)
+	if a.settings.TaskbarSide == side {
+		return
+	}
+	a.settings.TaskbarSide = side
+	a.settings.save()
+	a.syncTaskbar()
+	a.redraw()
+}
+
+func normalizedTaskbarSide(side string) string {
+	if side == "right" {
+		return "right"
+	}
+	return "left"
+}
+
+func (a *app) syncTaskbar() {
+	if a.taskbar != nil {
+		a.taskbar.sync()
+	}
+}
+
+func (a *app) closeTaskbar() {
+	if a.taskbar != nil {
+		a.taskbar.close()
+		a.taskbar = nil
+	}
+}
diff --git a/internal/app/taskbar_geometry.go b/internal/app/taskbar_geometry.go
new file mode 100644
index 0000000..ddaa121
--- /dev/null
+++ b/internal/app/taskbar_geometry.go
@@ -0,0 +1,137 @@
+package app
+
+import (
+	"math"
+	"sort"
+)
+
+// All geometry is in physical desktop pixels. Do not scale global X/Y by a
+// monitor's DPI: monitors with different scales do not share one DIP origin.
+type taskbarRect struct{ Left, Top, Right, Bottom int32 }
+
+func (r taskbarRect) width() int32  { return r.Right - r.Left }
+func (r taskbarRect) height() int32 { return r.Bottom - r.Top }
+func (r taskbarRect) valid() bool   { return r.width() > 0 && r.height() > 0 }
+func (r taskbarRect) overlaps(s taskbarRect) bool {
+	return r.Left < s.Right && s.Left < r.Right && r.Top < s.Bottom && s.Top < r.Bottom
+}
+
+// taskbarPlacement subtracts occupied controls and other widgets before
+// choosing a size. Unknown geometry never authorizes covering taskbar buttons.
+func taskbarPlacement(bar taskbarRect, occupied []taskbarRect, dpi uint32) (taskbarRect, bool) {
+	return taskbarPlacementForSide(bar, occupied, dpi, "left")
+}
+
+// taskbarPlacementForSide prefers the requested half even when that needs a
+// smaller panel. Only if no size fits there does it use the opposite half.
+func taskbarPlacementForSide(bar taskbarRect, occupied []taskbarRect, dpi uint32, side string) (taskbarRect, bool) {
+	if !bar.valid() || bar.height() > bar.width() || dpi < 48 || dpi > 768 {
+		return taskbarRect{}, false
+	}
+	px := func(dip int) int32 { return int32(math.Ceil(float64(dip) * float64(dpi) / 96)) }
+	if bar.height() < px(28) { // auto-hidden taskbars may expose only a thin edge
+		return taskbarRect{}, false
+	}
+	margin := px(6)
+	type span struct{ left, right int32 }
+	spans := []span{{bar.Left, bar.Left + px(12)}, {bar.Right - px(12), bar.Right}}
+	for _, r := range occupied {
+		if r.valid() && r.overlaps(bar) {
+			spans = append(spans, span{max(bar.Left, r.Left-margin), min(bar.Right, r.Right+margin)})
+		}
+	}
+	sort.Slice(spans, func(i, j int) bool { return spans[i].left < spans[j].left })
+	var gaps []span
+	left := bar.Left
+	for _, s := range spans {
+		if s.left > left {
+			gaps = append(gaps, span{left, s.left})
+		}
+		left = max(left, s.right)
+	}
+	if left < bar.Right {
+		gaps = append(gaps, span{left, bar.Right})
+	}
+	right := normalizedTaskbarSide(side) == "right"
+	midpoint := bar.Left + bar.width()/2
+	// A side is about available taskbar space, not a fixed desktop X. This
+	// also handles monitors left of the primary monitor and mixed DPI.
+	for _, preferredHalf := range []bool{true, false} {
+		for _, width := range []int{388, 248, 200, 108} {
+			for i := range gaps {
+				at := i
+				if right {
+					at = len(gaps) - 1 - i
+				}
+				gap := gaps[at]
+				if gap.right-gap.left < px(width) {
+					continue
+				}
+				x := gap.left
+				if right {
+					x = gap.right - px(width)
+				}
+				onPreferredHalf := (x+px(width)/2 >= midpoint) == right
+				if onPreferredHalf != preferredHalf {
+					continue
+				}
+				h := min(px(40), bar.height())
+				top := bar.Top + (bar.height()-h)/2
+				return taskbarRect{x, top, x + px(width), top + h}, true
+			}
+		}
+	}
+	return taskbarRect{}, false
+}
+
+type taskbarPlacements struct {
+	bar         taskbarRect
+	left, right taskbarRect
+	leftOK      bool
+	rightOK     bool
+}
+
+func (p taskbarPlacements) forSide(side string) (taskbarRect, bool) {
+	if normalizedTaskbarSide(side) == "right" {
+		return p.right, p.rightOK
+	}
+	return p.left, p.leftOK
+}
+
+// The frame previews the actual safe landing slot, not the moving strip's
+// current rectangle. Without an active drag or a measured slot it vanishes.
+func taskbarSnapPreviewPlacement(p taskbarPlacements, side string, dragging bool) (taskbarRect, bool) {
+	if !dragging || !p.bar.valid() {
+		return taskbarRect{}, false
+	}
+	r, ok := p.forSide(side)
+	if !ok || !r.valid() || r.Left < p.bar.Left || r.Right > p.bar.Right || r.Top < p.bar.Top || r.Bottom > p.bar.Bottom {
+		return taskbarRect{}, false
+	}
+	return r, true
+}
+
+// taskbarSideAtCursor maps a real drag's screen coordinate to a docking side.
+// Staying outside the taskbar vertically does not prevent reaching its side.
+func taskbarSideAtCursor(bar taskbarRect, x int32) string {
+	if bar.valid() && x >= bar.Left+bar.width()/2 {
+		return "right"
+	}
+	return "left"
+}
+
+// Keep the held panel's size and horizontal grab point under the cursor.
+// Release snaps to a safe slot; this preview cannot escape the taskbar.
+func taskbarDragPlacement(bar, start taskbarRect, grabX, cursorX int32) (taskbarRect, bool) {
+	if !bar.valid() || !start.valid() || start.width() > bar.width() || start.height() > bar.height() {
+		return taskbarRect{}, false
+	}
+	x := max(bar.Left, min(cursorX-grabX, bar.Right-start.width()))
+	y := max(bar.Top, min(start.Top, bar.Bottom-start.height()))
+	return taskbarRect{x, y, x + start.width(), y + start.height()}, true
+}
+
+func taskbarDragGrabOffset(start taskbarRect, cursorX int32, movedDIP float32, dpi uint32) int32 {
+	grab := cursorX - start.Left - int32(math.Round(float64(movedDIP)*float64(dpi)/96))
+	return max(0, min(grab, start.width()))
+}
diff --git a/internal/app/taskbar_lyric.go b/internal/app/taskbar_lyric.go
new file mode 100644
index 0000000..cdef081
--- /dev/null
+++ b/internal/app/taskbar_lyric.go
@@ -0,0 +1,74 @@
+package app
+
+import (
+	"strings"
+	"time"
+
+	"mygo-music/internal/lyrics"
+)
+
+type taskbarWidgetGesture struct {
+	x, y   float32
+	active bool
+}
+
+// taskbarLyricFrame uses playback time rather than a running UI animation,
+// so a pause or seek immediately paints the correct part of the same word.
+type taskbarLyricFrame struct {
+	text     string
+	words    []lyrics.Word
+	progress []float32
+	next     time.Duration
+}
+
+func taskbarLyricAt(lines []lyrics.Line, pos time.Duration, playing bool) taskbarLyricFrame {
+	frame := taskbarLyricFrame{}
+	cur := lyrics.Index(lines, pos)
+	wake := func(at time.Duration) {
+		if playing && at > pos && (frame.next == 0 || at-pos < frame.next) {
+			frame.next = at - pos
+		}
+	}
+	if cur+1 < len(lines) {
+		wake(lines[cur+1].At)
+	}
+	if cur < 0 {
+		return frame
+	}
+	line := lines[cur]
+	frame.text = line.Text
+	if !line.WordTimed || len(line.Words) == 0 {
+		return frame
+	}
+	// Reject incomplete/malformed word timing instead of highlighting the
+	// wrong text or passing an invalid interval to the sweep calculation.
+	var text strings.Builder
+	lastStart := line.At
+	for _, word := range line.Words {
+		if word.End <= word.Start || word.Start < lastStart {
+			return frame
+		}
+		lastStart = word.Start
+		text.WriteString(word.Text)
+	}
+	if strings.TrimSpace(text.String()) != strings.TrimSpace(line.Text) {
+		return frame
+	}
+	frame.words = line.Words
+	frame.progress = make([]float32, len(line.Words))
+	for i, word := range line.Words {
+		frame.progress[i] = clamp01(float32(pos-word.Start) / float32(word.End-word.Start))
+		if pos >= word.Start && pos < word.End {
+			wake(min(pos+40*time.Millisecond, word.End))
+		} else {
+			wake(word.Start)
+		}
+	}
+	return frame
+}
+
+// Keep the word being sung visible in a narrow taskbar slot. This depends
+// only on the lyric position, so paused lyrics never start a marquee timer.
+func taskbarLyricOffset(total, available, sung float32) float32 {
+	return min(max(0, total-available), max(0, sung-available*0.65))
+}
diff --git a/internal/app/taskbar_lyric_test.go b/internal/app/taskbar_lyric_test.go
new file mode 100644
index 0000000..e0e65e0
--- /dev/null
+++ b/internal/app/taskbar_lyric_test.go
@@ -0,0 +1,80 @@
+package app
+
+import (
+	"testing"
+	"time"
+
+	"mygo-music/internal/lyrics"
+)
+
+// Real word intervals drive the sweep, including a gap between words and
+// a seek backwards, without using UI elapsed time.
+func TestTaskbarLyricTimingAndSeek(t *testing.T) {
+	s := time.Second
+	lines := []lyrics.Line{
+		{At: s, End: 4 * s, Text: "你好", WordTimed: true, Words: []lyrics.Word{
+			{Text: "你", Start: s, End: 2 * s}, {Text: "好", Start: 3 * s, End: 4 * s},
+		}},
+		{At: 5 * s, End: 7 * s, Text: "下一句"},
+	}
+	for _, tc := range []struct {
+		pos           time.Duration
+		first, second float32
+		next          time.Duration
+	}{
+		{1500 * time.Millisecond, .5, 0, 40 * time.Millisecond},
+		{2500 * time.Millisecond, 1, 0, 500 * time.Millisecond},
+		{3500 * time.Millisecond, 1, .5, 40 * time.Millisecond},
+		{4 * s, 1, 1, s},
+		{1250 * time.Millisecond, .25, 0, 40 * time.Millisecond},
+	} {
+		frame := taskbarLyricAt(lines, tc.pos, true)
+		if len(frame.progress) != 2 || frame.progress[0] != tc.first || frame.progress[1] != tc.second || frame.next != tc.next {
+			t.Errorf("at %v: %+v", tc.pos, frame)
+		}
+	}
+	if before := taskbarLyricAt(lines, 0, true); before.text != "" || before.next != s {
+		t.Fatalf("intro: %+v", before)
+	}
+	if after := taskbarLyricAt(lines, 8*s, true); after.text != "下一句" || after.next != 0 {
+		t.Fatalf("outro: %+v", after)
+	}
+}
+
+// A paused word keeps its exact sung portion but requests no more frames;
+// estimated LRC words and malformed source words stay plain whole lines.
+func TestTaskbarLyricPauseAndPlainFallback(t *testing.T) {
+	line := lyrics.Line{At: 0, End: time.Second, Text: "Hello", WordTimed: true,
+		Words: []lyrics.Word{{Text: "Hello", Start: 0, End: time.Second}}}
+	frame := taskbarLyricAt([]lyrics.Line{line}, 500*time.Millisecond, false)
+	if len(frame.progress) != 1 || frame.progress[0] != .5 || frame.next != 0 {
+		t.Fatalf("paused: %+v", frame)
+	}
+	plain := lyrics.Build("[00:00.00]Hello\n[00:02.00]World", "")
+	frame = taskbarLyricAt(plain, 500*time.Millisecond, true)
+	if frame.text != "Hello" || len(frame.words) != 0 || frame.next != 1500*time.Millisecond {
+		t.Fatalf("line-only timing pretended to be word timing: %+v", frame)
+	}
+	for _, words := range [][]lyrics.Word{
+		{{Text: "Wrong", Start: 0, End: time.Second}},
+		{{Text: "Hello", Start: time.Second, End: 0}},
+	} {
+		line.Words = words
+		frame = taskbarLyricAt([]lyrics.Line{line}, 500*time.Millisecond, true)
+		if frame.text != "Hello" || len(frame.words) != 0 || frame.next != 0 {
+			t.Errorf("malformed timing: %+v", frame)
+		}
+	}
+}
+
+// Following a long line keeps the sung word in view, but never moves past
+// either edge and never scrolls text that already fits.
+func TestTaskbarLyricFollowing(t *testing.T) {
+	for _, tc := range []struct{ total, width, sung, want float32 }{
+		{300, 100, 0, 0}, {300, 100, 150, 85}, {300, 100, 300, 200}, {80, 100, 70, 0},
+	} {
+		if got := taskbarLyricOffset(tc.total, tc.width, tc.sung); got != tc.want {
+			t.Errorf("offset(%v): %v, want %v", tc, got, tc.want)
+		}
+	}
+}
