+package app
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"mygo-music/internal/music"
+)
+
+// Both listening-mode styles start the chosen continuous feed when clicked
+// after wrapping onto another grid row or when activated with Tab/Enter.
+func TestListeningModeStartsRadio(t *testing.T) {
+	for _, layout := range []string{"mode-buttons", "mode-covers"} {
+		for _, keyboard := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/keyboard=%v", layout, keyboard), func(t *testing.T) {
+				a, ch := radioApp()
+				st := a.stations[0]
+				st.Description = "Continue with songs chosen for this listening mode"
+				asked := make(chan string, 8)
+				fake(a).stationNext = func(id string) ([]music.Track, error) {
+					asked <- id
+					return sourced(song("one", "One"), song("two", "Two"), song("three", "Three"), song("four", "Four"), song("five", "Five")), nil
+				}
+				tt := ui.NewTester(func(c *ui.Context) {
+					a.pal = paletteFor(c.Theme())
+					ui.Column(c).Padding(12).Children(func() {
+						if layout == "mode-buttons" {
+							a.modeStationButton(c, &st)
+						} else {
+							a.modeStationCover(c, &st)
+						}
+					})
+				}, 320, 260)
+				if !keyboard {
+					a.route = route{page: pageBrowse, src: "fake", id: "listening"}
+					a.browses["listening"] = &browseData{at: time.Now(), page: &music.Browse{Title: "Listening modes", Sections: []music.Section{{Layout: layout, Stations: []music.Station{
+						{ID: "other-one", Name: "Other one"}, {ID: "other-two", Name: "Other two"}, st,
+					}}}}}
+					tt = ui.NewTester(a.view, 780, 900)
+				}
+				tt.Frame()
+				if keyboard {
+					tt.Key(0, ui.KeyTab)
+					if !tt.Focused(st.Name) {
+						t.Fatal("Tab did not focus the listening-mode card")
+					}
+					tt.Key(0, ui.KeyEnter)
+				} else if err := tt.Click(st.Name); err != nil {
+					t.Fatal(err)
+				}
+				if id := wait(t, asked, "listening-mode feed"); id != st.ID {
+					t.Fatalf("requested station %q", id)
+				}
+				until(t, ch, func() bool { return a.pl.Radio() != "" })
+				if a.pl.Radio() != radioName("fake", &st) || a.pl.Current() == nil || a.pl.Current().ID != "one" {
+					t.Fatalf("radio %q current=%+v", a.pl.Radio(), a.pl.Current())
+				}
+			})
+		}
+	}
+}
+
+// A page using mode-specific artwork still opens its full collection from
+// the section's See All action instead of starting or changing the radio.
+func TestListeningModesSeeAll(t *testing.T) {
+	a, ch, asked := browseApp()
+	a.home = &music.Browse{Sections: []music.Section{{Title: "Explore", Layout: "mode-covers", MorePage: "all-modes", Stations: []music.Station{{ID: "one", Name: "One"}}}}}
+	tt := ui.NewTester(a.view, 820, 780)
+	tt.Frame()
+	if err := tt.Click(T("See All")); err != nil {
+		t.Fatal(err)
+	}
+	if id := wait(t, asked, "the full modes page"); id != "all-modes" {
+		t.Fatalf("requested %q", id)
+	}
+	runPost(t, ch)
+	if a.route.id != "all-modes" || a.pl.Radio() != "" {
+		t.Fatalf("route %+v radio=%q", a.route, a.pl.Radio())
+	}
+}
+
+// With MM_FRAMES set, save the listening page in both themes and window
+// widths; optional MM_MODE_ICONS supplies real transparent plugin artwork.
+func TestListeningModesFrames(t *testing.T) {
+	dir := framesDir(t)
+	for _, width := range []int{1180, 820} {
+		for _, dark := range []bool{false, true} {
+			a := newTestApp()
+			framesTracks(a)
+			a.account = &music.Account{ID: "listener", Name: "Alex"}
+			commonNames := []string{"熟悉模式", "新鲜模式", "Chill 放松", "快乐时光", "动感健身", "夜晚", "治愈", "小酒馆"}
+			icons := []string{"familiar.png", "fresh.png", "scene-3.png", "scene-5.png", "scene-2.png", "scene-40.png", "scene-21.png", "scene-18.png"}
+			var common, explore []music.Station
+			for i, name := range commonNames {
+				st := music.Station{ID: fmt.Sprintf("common-%d", i), Name: name}
+				if iconDir := os.Getenv("MM_MODE_ICONS"); iconDir != "" {
+					data, err := os.ReadFile(filepath.Join(iconDir, icons[i]))
+					if err != nil {
+						t.Fatal(err)
+					}
+					bmp, _, size, err := artOf(data, 96)
+					if err != nil {
+						t.Fatal(err)
+					}
+					st.IconURL = fmt.Sprintf("icon:%d", i)
+					a.art.art[sized(st.IconURL, 96)] = &artwork{bmp: bmp, size: size}
+				}
+				common = append(common, st)
+			}
+			for i, name := range []string{"打游戏必备", "抖音爆火燃曲", "日语高燃", "通勤", "J-Pop 日本流行", "摸鱼模式", "甜美女声", "超萌嗓音"} {
+				explore = append(explore, music.Station{ID: fmt.Sprintf("explore-%d", i), Name: name, Description: []string{"让旋律陪你一起出发", "发现喜欢的声音，继续听下去", "前奏响起，主角登场", "通勤路上的心动旋律"}[i%4], ImageURL: fmt.Sprintf("cover:%d", i%3)})
+			}
+			a.route = route{page: pageBrowse, src: "fake", id: "listening"}
+			a.browses["listening"] = &browseData{at: time.Now(), page: &music.Browse{Title: "听歌模式", Sections: []music.Section{
+				{Title: "常用模式", Layout: "mode-buttons", Stations: common},
+				{Title: "探索更多新模式", Layout: "mode-covers", Stations: explore},
+			}}}
+			tt := ui.NewTester(a.view, width, 1050)
+			tt.SetDark(dark)
+			settled(tt)
+			saveFrame(t, dir, fmt.Sprintf("listening-modes-%d-dark-%v.png", width, dark), tt.Image())
+		}
+	}
+}
+
+// Real mode glyphs must retain their clear background through artOf and its
+// bitmap reload, unlike the oversized scene images converted to opaque JPEG.
+func TestListeningModeGlyphPipeline(t *testing.T) {
+	dir := os.Getenv("MM_MODE_ICONS")
+	if dir == "" {
+		t.Skip("set MM_MODE_ICONS to verify packaged glyphs through the host artwork pipeline")
+	}
+	files, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	checked := 0
+	for _, file := range files {
+		if file.IsDir() || !strings.HasSuffix(file.Name(), ".png") {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(dir, file.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		bmp, decoded, _, err := artOf(data, 96)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w, h := bmp.Size()
+		background := ui.RGB(244, 245, 246)
+		for _, reload := range []bool{false, true} {
+			if reload {
+				bmp.ReleasePixels()
+			}
+			tt := ui.NewTester(func(c *ui.Context) {
+				c.Root().Background(background)
+				ui.Box(c).Fill().Draw(func(p *ui.Painter, r ui.Rect) {
+					p.ImageRegion(bmp, ui.Rect{}, r, ui.ImageOptions{Tint: ui.RGB(25, 25, 25)})
+				})
+			}, w, h)
+			tt.Frame()
+			img := tt.Image()
+			corners := [][2]int{{0, 0}, {w - 1, 0}, {0, h - 1}, {w - 1, h - 1}}
+			clear := 0
+			for _, corner := range corners {
+				x, y := corner[0], corner[1]
+				if _, _, _, alpha := decoded.At(x, y).RGBA(); alpha != 0 {
+					continue
+				}
+				clear++
+				r, g, b, _ := img.At(x, y).RGBA()
+				if r>>8 != uint32(background.R) || g>>8 != uint32(background.G) || b>>8 != uint32(background.B) {
+					t.Fatalf("%s reload=%v acquired an opaque background at %d,%d: %d,%d,%d", file.Name(), reload, x, y, r>>8, g>>8, b>>8)
+				}
+			}
+			if clear == 0 {
+				t.Fatalf("%s has no transparent corner", file.Name())
+			}
+		}
+		checked++
+	}
+	if checked == 0 {
+		t.Fatal("no packaged mode PNGs found")
+	}
+	t.Logf("Verified %d PNG glyphs through artOf(96), tint and bitmap reload", checked)
+}
