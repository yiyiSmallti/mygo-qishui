@@ -0,0 +1,24 @@
+package app
+
+import "github.com/egoist/mygo/ui"
+
+// The native drag controller positions this click-through outline at the
+// exact safe slot that will receive the player when the pointer lets go.
+func (a *app) taskbarSnapPreviewView(c *ui.Context) {
+	theme := *c.Theme()
+	if a.tray != nil {
+		if a.tray.Dark() {
+			theme = *ui.DarkTheme()
+		} else {
+			theme = *ui.LightTheme()
+		}
+	}
+	p := paletteFor(&theme)
+	theme.Background = ui.Transparent
+	c.SetTheme(&theme)
+	c.Root().Background(ui.Transparent)
+	// Leave a small outer inset so the rounded stroke is never clipped at
+	// the native window edge. No controls, text or timers obstruct dragging.
+	ui.Box(c.Key("snap-outline")).Fill().Margin(1).Radius(8).PassThrough().
+		Background(p.accent.Alpha(0.13)).Border(2, p.accent.Alpha(0.95))
+}
