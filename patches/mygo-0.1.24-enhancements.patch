diff --git a/internal/app/taskbar_test.go b/internal/app/taskbar_test.go
new file mode 100644
index 0000000..faa3157
--- /dev/null
+++ b/internal/app/taskbar_test.go
@@ -0,0 +1,260 @@
+package app
+
+import (
+	"encoding/json"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"mygo-music/internal/music"
+)
+
+func TestTaskbarPlacementKeepsButtonsAndOtherPlayerClear(t *testing.T) {
+	bar := taskbarRect{0, 1032, 1920, 1080}
+	buttons := []taskbarRect{{800, 1032, 1400, 1080}, {1640, 1032, 1920, 1080}}
+	first, ok := taskbarPlacement(bar, buttons, 96)
+	if !ok || first != (taskbarRect{12, 1036, 400, 1076}) {
+		t.Fatalf("left full strip: %v %v", first, ok)
+	}
+	// Another music player already uses the leftmost slot. Keep its controls
+	// intact; find a different slot instead of laying our panel over it.
+	busy := append(append([]taskbarRect(nil), buttons...), first)
+	second, ok := taskbarPlacement(bar, busy, 96)
+	if !ok || second.overlaps(first) || second.Left != 406 {
+		t.Fatalf("existing player was covered: %v %v", second, ok)
+	}
+	for _, b := range buttons {
+		if second.overlaps(b) {
+			t.Fatalf("taskbar control was covered: %v", b)
+		}
+	}
+	// With the other player closed, the next measurement can use the left.
+	again, _ := taskbarPlacement(bar, buttons, 96)
+	if again != first {
+		t.Fatalf("free left slot not restored: %v", again)
+	}
+}
+
+func TestTaskbarPlacementShrinksBeforeHiding(t *testing.T) {
+	for _, tc := range []struct{ total, want int32 }{{500, 388}, {300, 248}, {160, 108}, {130, 0}} {
+		r, ok := taskbarPlacement(taskbarRect{0, 0, tc.total, 40}, nil, 96)
+		if ok != (tc.want != 0) || ok && r.width() != tc.want {
+			t.Fatalf("width %d: got %v %v", tc.total, r, ok)
+		}
+	}
+}
+
+func TestTaskbarPlacementMixedDPINegativeMonitor(t *testing.T) {
+	bar := taskbarRect{-1920, 1000, 0, 1060}
+	r, ok := taskbarPlacement(bar, []taskbarRect{{-900, 1000, 0, 1060}}, 144)
+	// Physical monitor origin is retained; only dimensions/margins scale.
+	want := taskbarRect{-1902, 1000, -1320, 1060}
+	if !ok || r != want {
+		t.Fatalf("150%% negative monitor: got %v %v want %v", r, ok, want)
+	}
+}
+
+func TestTaskbarPlacementHidesUnsupportedOrOccupiedBars(t *testing.T) {
+	for _, r := range []taskbarRect{{0, 1078, 1920, 1080}, {0, 0, 48, 1080}, {0, 0, 0, 0}} {
+		if result, ok := taskbarPlacement(r, nil, 96); ok {
+			t.Fatalf("auto-hidden/vertical/invalid bar was used: %v", result)
+		}
+	}
+	bar := taskbarRect{0, 1032, 1920, 1080}
+	if _, ok := taskbarPlacement(bar, []taskbarRect{{0, 0, 1920, 1080}}, 96); ok {
+		t.Fatal("full-screen window was covered")
+	}
+	if _, ok := taskbarPlacement(bar, nil, 0); ok {
+		t.Fatal("unknown DPI was guessed")
+	}
+}
+
+func TestTaskbarPlacementNeverOverlapsOccupiedGeometry(t *testing.T) {
+	rng := rand.New(rand.NewSource(41))
+	for n := 0; n < 300; n++ {
+		dpi := []uint32{96, 120, 144, 192}[rng.Intn(4)]
+		bar := taskbarRect{-2000, 1200, -80, 1200 + int32(dpi/2)}
+		var occupied []taskbarRect
+		for j := 0; j < rng.Intn(12); j++ {
+			x := int32(rng.Intn(2400) - 2200)
+			occupied = append(occupied, taskbarRect{x, bar.Top, x + int32(rng.Intn(500)+1), bar.Bottom})
+		}
+		for _, side := range []string{"left", "right"} {
+			r, ok := taskbarPlacementForSide(bar, occupied, dpi, side)
+			if !ok {
+				continue
+			}
+			if r.Left < bar.Left || r.Right > bar.Right || r.Top < bar.Top || r.Bottom > bar.Bottom {
+				t.Fatalf("%s placement escaped its monitor: %v in %v", side, r, bar)
+			}
+			for _, b := range occupied {
+				if r.overlaps(b) {
+					t.Fatalf("%s occupied geometry covered: widget %v, occupied %v", side, r, b)
+				}
+			}
+		}
+	}
+}
+
+// Dropping on the right uses its narrower safe slot before a larger left slot.
+func TestTaskbarPlacementKeepsRequestedSideBeforeWidth(t *testing.T) {
+	bar := taskbarRect{0, 1032, 1920, 1080}
+	occupied := []taskbarRect{{800, 1032, 1400, 1080}, {1640, 1032, 1920, 1080}}
+	right, ok := taskbarPlacementForSide(bar, occupied, 96, "right")
+	if !ok || right != (taskbarRect{1434, 1036, 1634, 1076}) {
+		t.Fatalf("right lyric strip should use the safe gap beside the tray: %v %v", right, ok)
+	}
+	left, ok := taskbarPlacementForSide(bar, occupied, 96, "left")
+	if !ok || left != (taskbarRect{12, 1036, 400, 1076}) {
+		t.Fatalf("left strip should return to the safe left edge: %v %v", left, ok)
+	}
+	occupied = append(occupied, taskbarRect{960, 1032, 1920, 1080})
+	fallback, ok := taskbarPlacementForSide(bar, occupied, 96, "right")
+	if !ok || fallback.Right >= 800 {
+		t.Fatalf("a blocked side must use a safe fallback without covering controls: %v %v", fallback, ok)
+	}
+}
+
+// A drag chooses the monitor-relative half, including negative physical origins.
+func TestTaskbarDragUsesMonitorCoordinates(t *testing.T) {
+	bar := taskbarRect{-1920, 1000, 0, 1060}
+	if taskbarSideAtCursor(bar, -1800) != "left" || taskbarSideAtCursor(bar, -500) != "right" {
+		t.Fatal("drag destination was not relative to the taskbar's monitor")
+	}
+	right, ok := taskbarPlacementForSide(bar, []taskbarRect{{-1100, 1000, -600, 1060}}, 144, "right")
+	if !ok || right != (taskbarRect{-390, 1000, -18, 1060}) {
+		t.Fatalf("150%% right placement: %v %v", right, ok)
+	}
+}
+
+// A real mouse move must move the strip before reaching the screen midpoint.
+func TestTaskbarDragFollowsPointerAndOnlySnapsOnRelease(t *testing.T) {
+	bar := taskbarRect{0, 1528, 2560, 1600}
+	start := taskbarRect{18, 1534, 600, 1594}
+	grab := int32(120)
+	for _, tc := range []struct{ cursor, wantLeft int32 }{
+		{138, 18}, {198, 78}, {938, 818}, {1738, 1618}, {4000, 1978}, {-1000, 0},
+	} {
+		r, ok := taskbarDragPlacement(bar, start, grab, tc.cursor)
+		if !ok || r.Left != tc.wantLeft || r.width() != start.width() || r.Top != start.Top || r.height() != start.height() {
+			t.Fatalf("cursor %d: got %v %v; wanted fixed-size strip at %d", tc.cursor, r, ok, tc.wantLeft)
+		}
+	}
+	// Released on the right, a narrower safe gap takes over without covering
+	// its application buttons or the system tray.
+	occupied := []taskbarRect{{900, 1528, 1700, 1600}, {2070, 1528, 2560, 1600}}
+	docked, ok := taskbarPlacementForSide(bar, occupied, 144, taskbarSideAtCursor(bar, 1800))
+	if !ok || docked.Left < 1700 || docked.Right >= 2070 || docked.width() != 300 {
+		t.Fatalf("release did not use the smaller right-side safe slot: %v %v", docked, ok)
+	}
+}
+
+// Fast moves crossing the whole panel in one frame retain the press anchor at 150% DPI.
+func TestTaskbarDragRecoversFastFirstMoveAndNegativeOrigin(t *testing.T) {
+	bar := taskbarRect{-2560, 1528, 0, 1600}
+	start := taskbarRect{-2542, 1534, -1960, 1594}
+	// Mouse went down 120 px into the panel, then moved 1000 physical px
+	// before the first UI build (666.67 DIP at 150%).
+	current := int32(-1422)
+	grab := taskbarDragGrabOffset(start, current, 1000*96.0/144, 144)
+	if grab != 120 {
+		t.Fatalf("first move lost the original grab point: %d", grab)
+	}
+	moved, ok := taskbarDragPlacement(bar, start, grab, current)
+	if !ok || moved.Left != -1542 || moved.width() != 582 {
+		t.Fatalf("fast mouse move did not follow the cursor: %v %v", moved, ok)
+	}
+	if _, ok := taskbarDragPlacement(taskbarRect{}, start, grab, current); ok {
+		t.Fatal("a vanished taskbar must cancel the preview")
+	}
+}
+
+// The snap frame follows the safe destination, including its smaller right-side size, and disappears without a drag.
+func TestTaskbarSnapPreviewTracksLandingSlotAndLifecycle(t *testing.T) {
+	p := taskbarPlacements{
+		bar:  taskbarRect{0, 1528, 2560, 1600},
+		left: taskbarRect{18, 1534, 600, 1594}, leftOK: true,
+		right: taskbarRect{1761, 1534, 2061, 1594}, rightOK: true,
+	}
+	for _, side := range []string{"left", "right"} {
+		r, ok := taskbarSnapPreviewPlacement(p, side, true)
+		want, _ := p.forSide(side)
+		if !ok || r != want {
+			t.Fatalf("%s preview did not match actual landing bounds: %v %v", side, r, ok)
+		}
+		if _, ok := taskbarSnapPreviewPlacement(p, side, false); ok {
+			t.Fatalf("%s preview survived release, cancellation or disabling", side)
+		}
+	}
+	// App icons changed while dragging: the live frame must shrink with the slot.
+	p.right.Left = p.right.Right - 162
+	if r, ok := taskbarSnapPreviewPlacement(p, "right", true); !ok || r.width() != 162 {
+		t.Fatalf("preview retained a stale size after taskbar occupancy changed: %v %v", r, ok)
+	}
+	p.rightOK = false
+	if _, ok := taskbarSnapPreviewPlacement(p, "right", true); ok {
+		t.Fatal("an unavailable destination must not keep a snap frame")
+	}
+	p.rightOK, p.right.Right = true, 2600
+	if _, ok := taskbarSnapPreviewPlacement(p, "right", true); ok {
+		t.Fatal("preview escaped the measured taskbar bounds")
+	}
+	if _, ok := taskbarSnapPreviewPlacement(taskbarPlacements{}, "left", true); ok {
+		t.Fatal("preview survived disappearance of the taskbar")
+	}
+}
+
+type testTaskbarController struct {
+	syncs, closes, begins, updates, ends, cancels int
+}
+
+func (w *testTaskbarController) sync()       { w.syncs++ }
+func (w *testTaskbarController) close()      { w.closes++ }
+func (w *testTaskbarController) beginDrag()  { w.begins++ }
+func (w *testTaskbarController) updateDrag() { w.updates++ }
+func (w *testTaskbarController) endDrag()    { w.ends++ }
+func (w *testTaskbarController) cancelDrag() { w.cancels++ }
+
+// Docking and dismissing persist the listener's choice without clearing playback.
+func TestTaskbarDockAndDismissPersistWithoutStoppingPlayer(t *testing.T) {
+	a := newTestApp()
+	a.settings.path = filepath.Join(t.TempDir(), "settings.json")
+	a.settings.TaskbarPlayer = true
+	a.pl.Cue([]music.Track{song("1", "First"), song("2", "Second")})
+	a.pl.TogglePlay()
+	if !a.pl.Playing() {
+		t.Fatal("test player did not enter playback")
+	}
+	panel := &testTaskbarController{}
+	a.taskbar = panel
+	a.beginTaskbarDrag()
+	a.updateTaskbarDrag()
+	a.endTaskbarDrag()
+	a.cancelTaskbarDrag()
+	if panel.begins != 1 || panel.updates != 1 || panel.ends != 1 || panel.cancels != 1 {
+		t.Fatalf("drag gestures did not reach the native panel: %+v", panel)
+	}
+	a.setTaskbarSide("right")
+	a.dismissTaskbarWidget()
+	bytes, err := os.ReadFile(a.settings.path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved settings
+	if err := json.Unmarshal(bytes, &saved); err != nil {
+		t.Fatal(err)
+	}
+	if saved.TaskbarSide != "right" || saved.TaskbarPlayer || panel.closes != 0 || panel.syncs == 0 {
+		t.Fatalf("dismiss did not retain a reopenable right-docked panel: settings=%+v panel=%+v", saved, panel)
+	}
+	if !a.pl.Playing() || a.pl.Current() == nil || a.pl.Current().ID != "1" || len(a.pl.Queue()) != 2 {
+		t.Fatal("dismissing the taskbar stopped playback or altered the queue")
+	}
+	a.settings.TaskbarPlayer = true
+	a.syncTaskbar()
+	a.setTaskbarSide("left")
+	if a.settings.TaskbarSide != "left" || !a.settings.TaskbarPlayer || panel.closes != 0 {
+		t.Fatal("the taskbar could not be reopened and moved back to the left")
+	}
+}
diff --git a/internal/app/taskbar_widget_view_windows.go b/internal/app/taskbar_widget_view_windows.go
new file mode 100644
index 0000000..fd4e83e
--- /dev/null
+++ b/internal/app/taskbar_widget_view_windows.go
@@ -0,0 +1,230 @@
+package app
+
+import (
+	"strings"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/ui"
+
+	"mygo-music/internal/music"
+)
+
+// taskbarWidgetView is the player in the taskbar's spare space. When that
+// space narrows, the cover, pause and next stay within reach.
+func (a *app) taskbarWidgetView(c *ui.Context) {
+	theme := *c.Theme()
+	// The transparent strip sits over the taskbar, whose appearance may
+	// differ from the app's (SystemUsesLightTheme vs AppsUseLightTheme).
+	if a.tray != nil {
+		if a.tray.Dark() {
+			theme = *ui.DarkTheme()
+		} else {
+			theme = *ui.LightTheme()
+		}
+	}
+	theme.Background = ui.Transparent
+	previousPalette := a.pal
+	a.pal = paletteFor(&theme)
+	defer func() { a.pal = previousPalette }()
+	p := a.pal
+	useAccent(&theme, p)
+	c.SetTheme(&theme)
+	c.Root().Background(ui.Transparent)
+
+	w, h := c.Size()
+	compact := w < 190
+	short := w < 240
+	artSize, iconSize, playSize := float32(32), float32(14), float32(18)
+	if w < 340 {
+		artSize, iconSize, playSize = 26, 12, 16
+	}
+	if compact {
+		artSize, iconSize, playSize = 20, 10, 14
+	}
+	artSize = min(artSize, max(20, h-8))
+	controlSize := min(iconSize+14, h-6)
+	playWidth := min(playSize+22, max(24, w/8))
+	playHeight := min(playSize+12, h-6)
+	titleSize, lyricSize := float32(10), float32(15)
+	if h < 34 {
+		titleSize, lyricSize = 8.5, 12
+	}
+	pl := a.pl
+	tr := pl.Current()
+	available := tr != nil && len(pl.Queue()) > 0
+	row := ui.Row(c.Key("taskbar-player")).Fill().Padding(2, 18, 2, 3).Gap(3).
+		AlignItems(ui.Center).Background(ui.Transparent)
+	row.Children(func() {
+		info := ui.ButtonBase(c.Key("track")).Grow(1).Shrink(1).MinWidth(artSize).
+			Height(h - 4).Gap(7).AlignItems(ui.Center).FocusRing(false).
+			Label(T("Open Now Playing")).Tooltip(T("Drag to move the taskbar player")).Cursor(ui.CursorGrab)
+		info.Children(func() {
+			if tr != nil {
+				a.cover(c.Key("cover"), tr.Album.ImageURL, 96, artSize, 6).Shrink(0)
+			} else {
+				ui.Box(c).Size(artSize, artSize).Shrink(0).Radius(6).Background(p.hover).Center().
+					Children(func() { ui.Icon(c, iconNote).Size(14, 14).TextColor(p.faint) })
+			}
+			if compact {
+				return
+			}
+			title, subtitle := T("Not Playing"), mygo.App.Name()
+			frame := taskbarLyricFrame{}
+			if tr != nil {
+				title, subtitle = tr.Name, tr.ArtistNames()
+				if pl.Loading() {
+					subtitle = T("Buffering…")
+				} else {
+					lines, _ := pl.Lyrics()
+					frame = taskbarLyricAt(lines, pl.Position(), pl.Playing())
+					if strings.TrimSpace(frame.text) != "" {
+						subtitle = frame.text
+					}
+					if frame.next > 0 {
+						c.After(frame.next)
+					}
+				}
+			}
+			ui.Column(c).Grow(1).Shrink(1).MinWidth(0).Gap(0).Children(func() {
+				ui.Text(c, title).FontSize(titleSize).FontWeight(500).TextColor(p.muted).SingleLine()
+				if len(frame.words) > 0 {
+					taskbarLyricText(c.Key("lyric"), frame, lyricSize, p.text)
+				} else {
+					ui.Text(c, subtitle).FontSize(lyricSize).FontWeight(650).LineHeight(1.15).TextColor(p.text).SingleLine()
+				}
+			})
+		})
+		wasDragging := a.taskbarWidgetDrag(info)
+		if a.taskbarGesture.active {
+			info.Cursor(ui.CursorGrabbing)
+		}
+		if info.Clicked() && !wasDragging {
+			if tr != nil {
+				a.nowPlaying = true
+			}
+			a.showMain()
+			a.redraw()
+		}
+
+		if !short && iconButton(c.Key("previous"), iconPrev, iconSize, p.text, T("Previous")).
+			Size(controlSize, controlSize).Shrink(0).Disabled(!available).Tooltip(T("Previous")).Clicked() {
+			pl.Prev()
+		}
+		play := ui.ButtonBase(c.Key("play")).Size(playWidth, playHeight).Center().Radius(999).
+			Background(p.text.Alpha(0.08)).TextColor(p.text).Shrink(0).Disabled(!available).
+			Label(T("Play/Pause")).Tooltip(T("Play/Pause"))
+		if play.Hovered() {
+			play.Background(p.text.Alpha(0.15))
+		}
+		play.Children(func() { playPause(c, play, pl.Playing(), playSize) })
+		if play.Clicked() {
+			pl.TogglePlay()
+		}
+		if iconButton(c.Key("next"), iconNext, iconSize, p.text, T("Next")).
+			Size(controlSize, controlSize).Shrink(0).Disabled(!available).Tooltip(T("Next")).Clicked() {
+			pl.Next()
+		}
+		if !short {
+			a.taskbarWidgetLike(c.Key("like"), tr, iconSize)
+		}
+	})
+	close := ui.ButtonBase(c.Key("close-taskbar")).Absolute().Right(0).Top(0).Size(16, 16).
+		Radius(8).Center().Label(T("Close taskbar player")).Tooltip(T("Close taskbar player"))
+	// Watch the whole native surface, including interactive children and
+	// transparent padding. Only the original corner remains a close target.
+	_, _, pointerOver := c.Root().PointerPosition()
+	if pointerOver || close.FocusVisible() {
+		close.Background(p.text.Alpha(0.13))
+		close.Children(func() { ui.Icon(c, iconX).Size(9, 9).TextColor(p.muted) })
+	}
+	if close.Clicked() {
+		a.dismissTaskbarWidget()
+	}
+	// This window still asks about its heart when the main view is hidden.
+	// Playback changes repaint the other windows only when their signature
+	// changes; paused and idle bars do not request a continuing timer.
+	a.askLikes()
+	a.syncWindows()
+}
+
+// A press still opens the main player; only moving beyond the small drag
+// threshold changes docking. Canceled pointer capture never commits it.
+func (a *app) taskbarWidgetDrag(info ui.Element) bool {
+	g := &a.taskbarGesture
+	wasDragging := g.active
+	dx, dy, held := info.Dragged()
+	if held {
+		g.x, g.y = g.x+dx, g.y+dy
+		if !g.active && g.x*g.x+g.y*g.y >= 16 {
+			g.active = true
+			a.beginTaskbarDragFrom(g.x)
+		}
+		if g.active {
+			a.updateTaskbarDrag()
+		}
+	} else {
+		if g.active {
+			if info.PressCanceled() {
+				a.cancelTaskbarDrag()
+			} else {
+				a.endTaskbarDrag()
+			}
+		}
+		*g = taskbarWidgetGesture{}
+	}
+	return wasDragging || g.active
+}
+
+// Paint each word twice: its dim outline, then the sung portion clipped to
+// playback progress. The same calculation also follows long lines in a
+// narrow slot, without an independent scrolling animation.
+func taskbarLyricText(c *ui.Context, frame taskbarLyricFrame, size float32, color ui.Color) {
+	ui.Box(c).FillWidth().Height(size * 1.3).Label(frame.text).Draw(func(p *ui.Painter, r ui.Rect) {
+		widths := make([]float32, len(frame.words))
+		total, sung, height := float32(0), float32(0), float32(0)
+		for i, word := range frame.words {
+			width, h := p.MeasureText(0, ui.Span{Text: word.Text, Size: size, Weight: 650})
+			widths[i], height = width, max(height, h)
+			if frame.progress[i] > 0 {
+				sung = total + width*frame.progress[i]
+			}
+			total += width
+		}
+		x, y := r.X-taskbarLyricOffset(total, r.W, sung), r.Y+(r.H-height)/2
+		p.Clip(r, 0, func() {
+			for i, word := range frame.words {
+				span := ui.Span{Text: word.Text, Size: size, Weight: 650, Color: color.Alpha(0.43)}
+				p.RichText(x, y, 0, span)
+				if lit := frame.progress[i]; lit > 0 {
+					span.Color = color
+					p.Clip(ui.Rect{X: x, Y: r.Y, W: widths[i] * lit, H: r.H}, 0, func() { p.RichText(x, y, 0, span) })
+				}
+				x += widths[i]
+			}
+		})
+	})
+}
+
+// taskbarWidgetLike keeps a read-only source's heart visible, while only
+// sources that support changing likes get the existing like action.
+func (a *app) taskbarWidgetLike(c *ui.Context, tr *music.Track, size float32) {
+	if tr != nil && a.trackLib(tr).canLike(tr) {
+		a.likeButton(c, tr, size, a.pal.muted).Shrink(0)
+		return
+	}
+	icon, color := iconHeart, a.pal.faint
+	if tr != nil {
+		a.wantLike(tr)
+		if a.isLiked(tr) {
+			icon, color = iconHeartFill, a.pal.accent
+		}
+	}
+	hint := T("This source does not support liking songs")
+	if tr == nil {
+		hint = T("Not Playing")
+	}
+	// The wrapper owns the tooltip, so it can explain a disabled button.
+	ui.Box(c).Shrink(0).Tooltip(hint).Children(func() {
+		iconButton(c, icon, size, color, T("Like")).Disabled(true)
+	})
+}
diff --git a/internal/app/taskbar_widget_view_windows_test.go b/internal/app/taskbar_widget_view_windows_test.go
new file mode 100644
index 0000000..cf74ac0
--- /dev/null
+++ b/internal/app/taskbar_widget_view_windows_test.go
@@ -0,0 +1,351 @@
+package app
+
+import (
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/ui"
+
+	"mygo-music/internal/lyrics"
+	"mygo-music/internal/music"
+)
+
+// The taskbar's controls change the same queue and playback state as the
+// full player, including when only its compact controls fit.
+func TestTaskbarWidgetTransport(t *testing.T) {
+	for _, bounds := range [][2]int{{388, 40}, {248, 40}, {200, 40}, {108, 40}, {388, 28}} {
+		width, height := bounds[0], bounds[1]
+		t.Run(fmt.Sprintf("%dx%d", width, height), func(t *testing.T) {
+			a := newTestApp()
+			a.pl.Cue([]music.Track{song("1", "First"), song("2", "Second"), song("3", "Third")})
+			a.pl.SetLyrics(nil)
+			tt := ui.NewTester(a.taskbarWidgetView, width, height)
+			tt.Frame()
+			if err := tt.Click("Next"); err != nil {
+				t.Fatal(err)
+			}
+			if a.pl.Current().ID != "2" || !a.pl.Playing() {
+				t.Fatalf("next: track %s, playing %v", a.pl.Current().ID, a.pl.Playing())
+			}
+			if err := tt.Click("Play/Pause"); err != nil {
+				t.Fatal(err)
+			}
+			if a.pl.Playing() {
+				t.Fatal("taskbar did not pause the player")
+			}
+			if width >= 240 {
+				if err := tt.Click("Previous"); err != nil {
+					t.Fatal(err)
+				}
+				if a.pl.Current().ID != "1" {
+					t.Fatalf("previous stayed on %s", a.pl.Current().ID)
+				}
+			}
+			if err := tt.Click("Open Now Playing"); err != nil {
+				t.Fatal(err)
+			}
+			if !a.nowPlaying {
+				t.Fatal("the cover did not open Now Playing")
+			}
+		})
+	}
+}
+
+type taskbarWidgetProbe struct{ begun, updated, ended, canceled, synced, closed int }
+
+func (p *taskbarWidgetProbe) beginDrag()  { p.begun++ }
+func (p *taskbarWidgetProbe) updateDrag() { p.updated++ }
+func (p *taskbarWidgetProbe) endDrag()    { p.ended++ }
+func (p *taskbarWidgetProbe) cancelDrag() { p.canceled++ }
+func (p *taskbarWidgetProbe) sync()       { p.synced++ }
+func (p *taskbarWidgetProbe) close()      { p.closed++ }
+
+// Moving the cover/text sends one drag lifecycle instead of opening the
+// main player, while an ordinary click remains the open action.
+func TestTaskbarWidgetDragDoesNotOpen(t *testing.T) {
+	a := newTestApp()
+	a.pl.Cue([]music.Track{song("1", "First")})
+	a.pl.SetLyrics(nil)
+	probe := &taskbarWidgetProbe{}
+	a.taskbar = probe
+	tt := ui.NewTester(a.taskbarWidgetView, 388, 40)
+	tt.Frame()
+	r, ok := tt.Find("Open Now Playing")
+	if !ok {
+		t.Fatal("missing track drag surface")
+	}
+	x, y := r.X+12, r.Y+r.H/2
+	tt.Press(x, y)
+	tt.Frame()
+	tt.Move(x+25, y)
+	tt.Frame()
+	tt.Move(x+90, y)
+	tt.Frame()
+	tt.Release(x+90, y)
+	tt.Frame()
+	tt.Frame()
+	if probe.begun != 1 || probe.updated == 0 || probe.ended != 1 || a.nowPlaying {
+		t.Fatalf("drag lifecycle=%+v, opened=%v", probe, a.nowPlaying)
+	}
+	if err := tt.Click("Open Now Playing"); err != nil {
+		t.Fatal(err)
+	}
+	if !a.nowPlaying {
+		t.Fatal("click after dragging did not open the player")
+	}
+}
+
+// Closing the small panel disables and persists only that panel, while
+// leaving the currently playing queue untouched and still controllable.
+func TestTaskbarWidgetCloseKeepsPlayback(t *testing.T) {
+	a := newTestApp()
+	a.settings.TaskbarPlayer = true
+	a.pl.Cue([]music.Track{song("1", "First")})
+	a.pl.Hold(time.Second)
+	a.pl.SetLyrics(nil)
+	probe := &taskbarWidgetProbe{}
+	a.taskbar = probe
+	tt := ui.NewTester(a.taskbarWidgetView, 200, 40)
+	tt.Frame()
+	if err := tt.Click("Close taskbar player"); err != nil {
+		t.Fatal(err)
+	}
+	if a.settings.TaskbarPlayer || !a.pl.Playing() || a.pl.Current().ID != "1" || probe.closed != 0 || probe.synced == 0 {
+		t.Fatalf("close changed playback or did not hide panel: settings=%v playing=%v probe=%+v", a.settings.TaskbarPlayer, a.pl.Playing(), probe)
+	}
+}
+
+func taskbarCloseCoverage(tt *ui.Tester, r ui.Rect) uint64 {
+	im := tt.Image()
+	var alpha uint64
+	for y := int(r.Y); y < int(r.Y+r.H); y++ {
+		for x := int(r.X); x < int(r.X+r.W); x++ {
+			_, _, _, a := im.At(x, y).RGBA()
+			alpha += uint64(a)
+		}
+	}
+	return alpha
+}
+
+// The close glyph used to require hovering its corner; entering the cover,
+// lyrics, transport controls or padding must reveal it without enlarging its hit target.
+func TestTaskbarWidgetCloseRevealsAcrossPlayer(t *testing.T) {
+	for _, width := range []int{388, 248, 200, 108} {
+		t.Run(fmt.Sprint(width), func(t *testing.T) {
+			a := newTestApp()
+			a.settings.TaskbarPlayer = true
+			a.pl.Cue([]music.Track{song("1", "First")})
+			a.pl.Hold(time.Second)
+			a.pl.SetLyrics([]lyrics.Line{{At: 0, End: 10 * time.Second, Text: "Current lyric"}})
+			tt := ui.NewTester(a.taskbarWidgetView, width, 40)
+			tt.Frame()
+			close, ok := tt.Find("Close taskbar player")
+			if !ok {
+				t.Fatal("missing close hit area")
+			}
+			tt.Move(-10, -10)
+			tt.Frame()
+			if taskbarCloseCoverage(tt, close) != 0 {
+				t.Fatal("close is painted outside the player")
+			}
+			info, ok := tt.Find("Open Now Playing")
+			if !ok {
+				t.Fatal("missing track surface")
+			}
+			points := []ui.Point{{X: info.X + 10, Y: info.Y + info.H/2}, {X: .5, Y: .5}}
+			labels := []string{"Play/Pause", "Next", "Close taskbar player"}
+			if width >= 190 {
+				labels = append(labels, "Current lyric")
+			}
+			if width >= 240 {
+				labels = append(labels, "Previous", "Like")
+			}
+			for _, label := range labels {
+				r, ok := tt.Find(label)
+				if !ok {
+					t.Fatalf("missing hover target %s", label)
+				}
+				points = append(points, ui.Point{X: r.X + r.W/2, Y: r.Y + r.H/2})
+			}
+			for _, point := range points {
+				tt.Move(point.X, point.Y)
+				tt.Frame()
+				if taskbarCloseCoverage(tt, close) == 0 {
+					t.Fatalf("hover at %v did not reveal close", point)
+				}
+				tt.Move(float32(width)+5, 45)
+				tt.Frame()
+				if taskbarCloseCoverage(tt, close) != 0 {
+					t.Fatalf("close stayed visible after leaving %v", point)
+				}
+			}
+			tt.Move(info.X+10, info.Y+info.H/2)
+			tt.Frame()
+			if tt.Cursor() != ui.CursorGrab {
+				t.Fatal("track area lost the drag cursor")
+			}
+			if err := tt.Click("Play/Pause"); err != nil {
+				t.Fatal(err)
+			}
+			if !a.settings.TaskbarPlayer {
+				t.Fatal("play control was replaced by a larger close target")
+			}
+			if err := tt.Click("Close taskbar player"); err != nil {
+				t.Fatal(err)
+			}
+			if a.settings.TaskbarPlayer {
+				t.Fatal("revealed close control did not hide the taskbar player")
+			}
+		})
+	}
+}
+
+// Keyboard navigation still reveals and activates the close control when
+// the pointer is outside the taskbar player.
+func TestTaskbarWidgetCloseRevealsForKeyboard(t *testing.T) {
+	a := newTestApp()
+	a.settings.TaskbarPlayer = true
+	tt := ui.NewTester(a.taskbarWidgetView, 388, 40)
+	tt.Frame()
+	tt.Move(-10, -10)
+	tt.Frame()
+	r, ok := tt.Find("Close taskbar player")
+	if !ok {
+		t.Fatal("missing close target")
+	}
+	for range 8 {
+		tt.Key(0, ui.KeyTab)
+		tt.Frame()
+		if close, found := tt.Access("Close taskbar player"); found && close.Focused {
+			if taskbarCloseCoverage(tt, r) == 0 {
+				t.Fatal("keyboard focus did not reveal close")
+			}
+			tt.Key(0, ui.KeyEnter)
+			tt.Frame()
+			if a.settings.TaskbarPlayer {
+				t.Fatal("keyboard could not close the player")
+			}
+			return
+		}
+	}
+	t.Fatal("close target could not be reached with Tab")
+}
+
+// With the main window absent, the taskbar still asks for the current
+// heart and sends the opposite state when the listener presses it.
+func TestTaskbarWidgetLikeWithoutMainView(t *testing.T) {
+	a := newTestApp()
+	ch := posts(a)
+	asked, changed := make(chan []string, 1), make(chan bool, 1)
+	fake(a).isLiked = func(ids []string) (map[string]bool, error) {
+		asked <- ids
+		return map[string]bool{"1": true}, nil
+	}
+	fake(a).like = func(_ string, on bool) error { changed <- on; return nil }
+	a.account = &music.Account{ID: "listener"}
+	a.pl.Cue([]music.Track{song("1", "First")})
+	a.pl.SetLyrics(nil)
+	tt := ui.NewTester(a.taskbarWidgetView, 248, 40)
+	tt.Frame()
+	if ids := wait(t, asked, "the current heart"); len(ids) != 1 || ids[0] != "1" {
+		t.Fatalf("asked for likes of %v", ids)
+	}
+	runPost(t, ch)
+	tt.Frame()
+	if err := tt.Click("Unlike"); err != nil {
+		t.Fatal(err)
+	}
+	if a.isLiked(a.pl.Current()) || wait(t, changed, "the unlike") {
+		t.Fatal("the heart did not unlike the current song")
+	}
+}
+
+// A source whose likes can only be read keeps that state when its
+// disabled heart is pressed, without issuing a write to the source.
+func TestTaskbarWidgetReadOnlyHeart(t *testing.T) {
+	a := newTestApp()
+	without(a, "like")
+	a.account = &music.Account{ID: "listener"}
+	a.liked = map[string]bool{"1": true}
+	writes := make(chan bool, 1)
+	fake(a).like = func(_ string, on bool) error { writes <- on; return nil }
+	a.pl.Cue([]music.Track{song("1", "First")})
+	a.pl.SetLyrics(nil)
+	tt := ui.NewTester(a.taskbarWidgetView, 388, 40)
+	tt.Frame()
+	if heart, ok := tt.AccessByRole(ui.RoleButton, "Like"); !ok || !heart.Disabled {
+		t.Fatal("the source cannot change likes, but its heart is actionable")
+	}
+	r, ok := tt.Find("Like")
+	if !ok {
+		t.Fatal("no read-only heart to press")
+	}
+	tt.ClickAt(r.X+r.W/2, r.Y+r.H/2)
+	if !a.isLiked(a.pl.Current()) {
+		t.Fatal("pressing the read-only heart changed its state")
+	}
+	select {
+	case <-writes:
+		t.Fatal("the read-only heart wrote to its source")
+	default:
+	}
+}
+
+// Without a queued track, pressing the taskbar controls cannot start
+// playback, and opening the app does not open an empty Now Playing view.
+func TestTaskbarWidgetEmptyControls(t *testing.T) {
+	a := newTestApp()
+	tt := ui.NewTester(a.taskbarWidgetView, 388, 40)
+	tt.Frame()
+	for _, label := range []string{"Previous", "Play/Pause", "Next", "Like"} {
+		if control, ok := tt.AccessByRole(ui.RoleButton, label); !ok || !control.Disabled {
+			t.Fatalf("%s is actionable without a track", label)
+		}
+		r, ok := tt.Find(label)
+		if !ok {
+			t.Fatalf("no %s control to press", label)
+		}
+		tt.ClickAt(r.X+r.W/2, r.Y+r.H/2)
+	}
+	if a.pl.Current() != nil || a.pl.Playing() {
+		t.Fatal("an empty taskbar started playback")
+	}
+	if err := tt.Click("Open Now Playing"); err != nil {
+		t.Fatal(err)
+	}
+	if a.nowPlaying {
+		t.Fatal("opened Now Playing with no current track")
+	}
+}
+
+// With MM_FRAMES set, saves the taskbar at each width in both appearances.
+func TestTaskbarWidgetFrames(t *testing.T) {
+	dir := framesDir(t)
+	for _, dark := range []bool{false, true} {
+		for _, width := range []int{388, 248, 200, 108} {
+			a := newTestApp()
+			tracks := framesTracks(a)
+			tracks[0].Name = "如果可以"
+			tracks[0].Artists = []music.Artist{{Name: "韦礼安"}}
+			a.pl.Cue(tracks)
+			a.pl.Hold(3500 * time.Millisecond)
+			a.pl.SetLyrics(lyrics.FromSource(&music.Lyrics{Lines: []music.LyricLine{{Start: 0, End: 10000, Text: "未曾想这情一字多么长", Words: []music.LyricWord{
+				{Text: "未", Start: 0, End: 1000}, {Text: "曾", Start: 1000, End: 2000}, {Text: "想", Start: 2000, End: 3000}, {Text: "这", Start: 3000, End: 4000}, {Text: "情", Start: 4000, End: 5000}, {Text: "一", Start: 5000, End: 6000}, {Text: "字", Start: 6000, End: 7000}, {Text: "多", Start: 7000, End: 8000}, {Text: "么", Start: 8000, End: 9000}, {Text: "长", Start: 9000, End: 10000},
+			}}}}))
+			tt := ui.NewTester(func(c *ui.Context) {
+				a.taskbarWidgetView(c)
+				// Give the transparent player a representative taskbar surface
+				// in previews, so opacity and the word sweep remain visible.
+				background := ui.LightTheme().Background
+				if dark {
+					background = ui.DarkTheme().Background
+				}
+				c.Root().Background(background)
+			}, width, 40)
+			tt.SetDark(dark)
+			settled(tt)
+			saveFrame(t, dir, fmt.Sprintf("taskbar-%d-dark-%v.png", width, dark), tt.Image())
+		}
+	}
+}
diff --git a/internal/app/taskbar_windows.go b/internal/app/taskbar_windows.go
new file mode 100644
index 0000000..c26efc9
--- /dev/null
+++ b/internal/app/taskbar_windows.go
@@ -0,0 +1,449 @@
+//go:build windows
+
+package app
+
+import (
+	"runtime"
+	"sync/atomic"
+	"time"
+	"unsafe"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/ui"
+	"golang.org/x/sys/windows"
+)
+
+var (
+	taskbarUser32            = windows.NewLazySystemDLL("user32.dll")
+	taskbarGetRect           = taskbarUser32.NewProc("GetWindowRect")
+	taskbarGetCursor         = taskbarUser32.NewProc("GetCursorPos")
+	taskbarGetAsyncKey       = taskbarUser32.NewProc("GetAsyncKeyState")
+	taskbarGetCapture        = taskbarUser32.NewProc("GetCapture")
+	taskbarReleaseCapture    = taskbarUser32.NewProc("ReleaseCapture")
+	taskbarGetClass          = taskbarUser32.NewProc("GetClassNameW")
+	taskbarVisible           = taskbarUser32.NewProc("IsWindowVisible")
+	taskbarEnumWindows       = taskbarUser32.NewProc("EnumWindows")
+	taskbarGetDPI            = taskbarUser32.NewProc("GetDpiForWindow")
+	taskbarSetThreadDPI      = taskbarUser32.NewProc("SetThreadDpiAwarenessContext")
+	taskbarSetPos            = taskbarUser32.NewProc("SetWindowPos")
+	taskbarGetLong           = taskbarUser32.NewProc("GetWindowLongPtrW")
+	taskbarSetLong           = taskbarUser32.NewProc("SetWindowLongPtrW")
+	taskbarForeground        = taskbarUser32.NewProc("GetForegroundWindow")
+	taskbarAncestor          = taskbarUser32.NewProc("GetAncestor")
+	taskbarLayeredAttributes = taskbarUser32.NewProc("GetLayeredWindowAttributes")
+	taskbarMonitorFromWindow = taskbarUser32.NewProc("MonitorFromWindow")
+	taskbarGetMonitorInfo    = taskbarUser32.NewProc("GetMonitorInfoW")
+	taskbarDWM               = windows.NewLazySystemDLL("dwmapi.dll")
+	taskbarGetDWMAttribute   = taskbarDWM.NewProc("DwmGetWindowAttribute")
+	taskbarSetDWMAttribute   = taskbarDWM.NewProc("DwmSetWindowAttribute")
+)
+
+type windowsTaskbar struct {
+	a           *app
+	win         *mygo.Window
+	hwnd        uintptr
+	preview     *mygo.Window
+	previewHWND uintptr // assigned before watch starts; stable until shutdown
+	stop        chan struct{}
+	wake        chan struct{}
+	enabled     atomic.Bool
+	closed      bool              // UI thread only
+	slots       taskbarPlacements // UI thread only; measured on the worker
+	dragging    bool
+	dragSide    string
+	dragStart   taskbarRect
+	dragGrabX   int32
+	dragPoll    chan struct{} // UI-thread owner; closed for release/cancel/disable
+}
+
+func (a *app) installTaskbar() {
+	if a.taskbar != nil {
+		return
+	}
+	w := &windowsTaskbar{a: a, stop: make(chan struct{}), wake: make(chan struct{}, 1)}
+	w.win = mygo.NewWindow(mygo.WindowOptions{
+		Title: "MyGo Taskbar Player", Panel: true, Hidden: true,
+		Frameless: true, Transparent: true, DisableShadow: true,
+		// DisableMove also blocks SetWindowPos. The view handles pointer
+		// dragging itself so the panel can only land in measured safe slots.
+		DisableResize: true, DisableMinimize: true,
+		DisableMaximize: true, Width: 388, Height: 40,
+		Content: ui.View(a.taskbarWidgetView),
+	})
+	w.hwnd = w.win.NativeHandle()
+	// Panel enables DWM's rounded outline even for a frameless transparent
+	// window. Suppress that system frame as well as the view's own border.
+	// Windows 10 ignores these Windows 11 attributes and stays frameless.
+	borderNone, squareCorners := uint32(0xfffffffe), uint32(1)
+	taskbarSetDWMAttribute.Call(w.hwnd, 34, uintptr(unsafe.Pointer(&borderNone)), 4)
+	taskbarSetDWMAttribute.Call(w.hwnd, 33, uintptr(unsafe.Pointer(&squareCorners)), 4)
+	// Own top-level window only: never inject into or reparent to Explorer.
+	// Retaining MyGo's owner makes the panel survive an Explorer restart.
+	const exStyle = ^uintptr(19) // GWL_EXSTYLE = -20
+	style, _, _ := taskbarGetLong.Call(w.hwnd, exStyle)
+	taskbarSetLong.Call(w.hwnd, exStyle, style|0x08000000|0x80) // NOACTIVATE, TOOLWINDOW
+	w.win.OnClose(func(e *mygo.CloseEvent) {
+		if !w.closed && !a.quitting {
+			e.PreventDefault()
+		}
+	})
+	w.preview = mygo.NewWindow(mygo.WindowOptions{
+		Title: "MyGo Taskbar Snap Preview", Panel: true, Hidden: true,
+		Frameless: true, Transparent: true, DisableShadow: true,
+		DisableResize: true, DisableMinimize: true, DisableMaximize: true,
+		DisableClose: true, Width: 388, Height: 40,
+		Content: ui.View(a.taskbarSnapPreviewView),
+	})
+	w.previewHWND = w.preview.NativeHandle()
+	// This pane is only a visual destination, never an input surface. The
+	// framework combines WS_EX_TRANSPARENT and WS_EX_LAYERED for actual
+	// click-through behavior, including over another application's window.
+	w.preview.SetIgnoreMouseEvents(true)
+	style, _, _ = taskbarGetLong.Call(w.previewHWND, exStyle)
+	taskbarSetLong.Call(w.previewHWND, exStyle, style|0x08000000|0x80)
+	taskbarSetDWMAttribute.Call(w.previewHWND, 34, uintptr(unsafe.Pointer(&borderNone)), 4)
+	taskbarSetDWMAttribute.Call(w.previewHWND, 33, uintptr(unsafe.Pointer(&squareCorners)), 4)
+	w.preview.OnClose(func(e *mygo.CloseEvent) {
+		if !w.closed && !a.quitting {
+			e.PreventDefault()
+			w.preview.Hide()
+		}
+	})
+	a.taskbar = w
+	w.sync()
+	go w.watch()
+}
+
+func (w *windowsTaskbar) sync() {
+	if w.closed {
+		return
+	}
+	on := w.a.settings.TaskbarPlayer && !w.a.quitting
+	changed := w.enabled.Swap(on) != on
+	if !on {
+		w.hideSnapPreview()
+		w.stopDragPolling()
+		w.dragging = false
+		w.releaseDragCapture()
+		w.win.Hide()
+	} else {
+		if !w.dragging {
+			w.hideSnapPreview()
+			r, ok := w.slots.forSide(w.a.settings.TaskbarSide)
+			w.apply(r, ok)
+		}
+		w.win.Invalidate()
+	}
+	if changed {
+		select {
+		case w.wake <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func (w *windowsTaskbar) close() {
+	if w.closed {
+		return
+	}
+	w.closed = true
+	w.hideSnapPreview()
+	w.stopDragPolling()
+	w.dragging = false
+	w.releaseDragCapture()
+	w.enabled.Store(false)
+	close(w.stop)
+	if w.preview != nil {
+		w.preview.Destroy()
+	}
+	w.win.Destroy()
+}
+
+func (w *windowsTaskbar) watch() {
+	// UI Automation clients run on a dedicated MTA thread, never the UI
+	// thread: a slow/unresponsive Explorer must not freeze audio or controls.
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	probe := newTaskbarProbe()
+	if probe == nil {
+		return
+	} // no trustworthy control bounds: remain hidden
+	defer probe.close()
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		if w.enabled.Load() {
+			slots := probe.placements(w.hwnd, w.previewHWND)
+			mygo.RunOnMain(func() { w.applyPlacements(slots) })
+		}
+		select {
+		case <-w.stop:
+			return
+		case <-ticker.C:
+		case <-w.wake:
+		}
+	}
+}
+
+func (w *windowsTaskbar) applyPlacements(slots taskbarPlacements) {
+	if w.closed {
+		return
+	}
+	w.slots = slots
+	if w.dragging {
+		w.updateDrag()
+		return
+	}
+	r, ok := slots.forSide(w.a.settings.TaskbarSide)
+	w.apply(r, ok)
+}
+
+func (w *windowsTaskbar) beginDrag() {
+	w.beginDragFrom(0)
+}
+
+func (w *windowsTaskbar) beginDragFrom(deltaX float32) {
+	if w.closed || !w.enabled.Load() || !w.slots.bar.valid() {
+		return
+	}
+	var point struct{ X, Y int32 }
+	if ok, _, _ := taskbarGetCursor.Call(uintptr(unsafe.Pointer(&point))); ok == 0 {
+		return
+	}
+	start, ok := taskbarWindowRect(w.hwnd)
+	if !ok {
+		return
+	}
+	dpi, _, _ := taskbarGetDPI.Call(w.hwnd)
+	if dpi == 0 {
+		return
+	}
+	w.stopDragPolling()
+	w.dragStart = start
+	w.dragGrabX = taskbarDragGrabOffset(start, point.X, deltaX, uint32(dpi))
+	w.dragging = true
+	w.dragSide = normalizedTaskbarSide(w.a.settings.TaskbarSide)
+	w.updateDrag()
+	if !w.dragging {
+		return
+	}
+	// A NOACTIVATE panel cannot rely on SetCapture for moves and releases
+	// outside its HWND. Poll only while this one real drag is in progress,
+	// without a global hook or a continuing animation while paused.
+	done := make(chan struct{})
+	w.dragPoll = done
+	go func() {
+		ticker := time.NewTicker(16 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-done:
+				return
+			case <-w.stop:
+				return
+			case <-ticker.C:
+				mygo.RunOnMain(func() {
+					if w.dragPoll == done {
+						w.pollDrag()
+					}
+				})
+			}
+		}
+	}()
+}
+
+func (w *windowsTaskbar) stopDragPolling() {
+	if w.dragPoll != nil {
+		close(w.dragPoll)
+		w.dragPoll = nil
+	}
+}
+
+func (w *windowsTaskbar) releaseDragCapture() {
+	capture, _, _ := taskbarGetCapture.Call()
+	if capture == 0 {
+		return
+	}
+	root, _, _ := taskbarAncestor.Call(capture, 2) // GA_ROOT
+	if capture == w.hwnd || root == w.hwnd {
+		// Give MyGo its normal capture-canceled message if the real mouse
+		// release happened outside this nonactive window. Never release a
+		// different app's capture, and never synthesize mouse input.
+		taskbarReleaseCapture.Call()
+	}
+}
+
+func (w *windowsTaskbar) pollDrag() {
+	if w.closed || !w.dragging || !w.enabled.Load() {
+		w.hideSnapPreview()
+		w.stopDragPolling()
+		return
+	}
+	escape, _, _ := taskbarGetAsyncKey.Call(0x1b)
+	if escape&0x8000 != 0 {
+		w.cancelDrag()
+		return
+	}
+	down, _, _ := taskbarGetAsyncKey.Call(0x01) // VK_LBUTTON
+	if down&0x8000 == 0 {
+		w.endDrag()
+		return
+	}
+	w.updateDrag()
+}
+
+func (w *windowsTaskbar) updateDrag() {
+	if !w.dragging || w.closed || !w.enabled.Load() {
+		return
+	}
+	var point struct{ X, Y int32 }
+	if ok, _, _ := taskbarGetCursor.Call(uintptr(unsafe.Pointer(&point))); ok == 0 {
+		return
+	}
+	w.dragSide = taskbarSideAtCursor(w.slots.bar, point.X)
+	r, ok := taskbarDragPlacement(w.slots.bar, w.dragStart, w.dragGrabX, point.X)
+	if !ok {
+		w.cancelDrag()
+		return
+	}
+	w.updateSnapPreview()
+	// A held but stationary mouse needs no placement or rendering work.
+	if current, valid := taskbarWindowRect(w.hwnd); valid && current == r {
+		return
+	}
+	w.apply(r, ok)
+}
+
+func (w *windowsTaskbar) endDrag() {
+	if !w.dragging {
+		return
+	}
+	w.updateDrag()
+	if !w.dragging {
+		return
+	}
+	w.stopDragPolling()
+	w.dragging = false
+	w.hideSnapPreview()
+	w.a.setTaskbarSide(w.dragSide)
+	r, ok := w.slots.forSide(w.a.settings.TaskbarSide)
+	w.apply(r, ok)
+	w.releaseDragCapture()
+}
+
+func (w *windowsTaskbar) cancelDrag() {
+	w.hideSnapPreview()
+	if !w.dragging {
+		w.stopDragPolling()
+		return
+	}
+	w.stopDragPolling()
+	w.dragging = false
+	r, ok := w.slots.forSide(w.a.settings.TaskbarSide)
+	w.apply(r, ok)
+	w.releaseDragCapture()
+}
+
+func (w *windowsTaskbar) hideSnapPreview() {
+	if w.preview != nil && w.preview.IsVisible() {
+		w.preview.Hide()
+	}
+}
+
+func (w *windowsTaskbar) updateSnapPreview() {
+	r, ok := taskbarSnapPreviewPlacement(w.slots, w.dragSide, w.dragging && w.enabled.Load() && !w.closed)
+	if w.preview == nil || !ok {
+		w.hideSnapPreview()
+		return
+	}
+	current, valid := taskbarWindowRect(w.previewHWND)
+	if valid && current == r && w.preview.IsVisible() {
+		return
+	}
+	// Use physical coordinates, including on mixed-DPI/negative monitors.
+	// A changed rectangle stays hidden until WM_DPICHANGED has settled.
+	w.hideSnapPreview()
+	const flags = 0x10 | 0x200 // NOACTIVATE | NOOWNERZORDER
+	place := func() {
+		// Insert behind the player's HWND within the topmost band. Neither
+		// moving nor revealing the preview ever activates it or takes capture.
+		taskbarSetPos.Call(w.previewHWND, w.hwnd, uintptr(r.Left), uintptr(r.Top), uintptr(r.width()), uintptr(r.height()), flags)
+	}
+	place()
+	current, valid = taskbarWindowRect(w.previewHWND)
+	if !valid || current != r {
+		place()
+		current, valid = taskbarWindowRect(w.previewHWND)
+	}
+	if !valid || current != r {
+		return
+	}
+	w.preview.ShowInactive()
+	// Showing a panel can raise it. Reassert the player's place in front.
+	place()
+	w.preview.Invalidate()
+}
+
+func (w *windowsTaskbar) apply(r taskbarRect, ok bool) {
+	if w.closed {
+		return
+	}
+	if !ok || !w.enabled.Load() {
+		w.hideSnapPreview()
+		w.win.Hide()
+		return
+	}
+	// Position in physical pixels; Windows delivers WM_DPICHANGED to MyGo,
+	// which scales native text/icons at the destination monitor's DPI.
+	// Do not SetForegroundWindow: media clicks leave the current app focused.
+	const flags = 0x10 | 0x200 // NOACTIVATE | NOOWNERZORDER
+	current, valid := taskbarWindowRect(w.hwnd)
+	if (!valid || current != r) && !w.dragging {
+		w.win.Hide()
+	}
+	place := func() {
+		taskbarSetPos.Call(w.hwnd, ^uintptr(0), uintptr(r.Left), uintptr(r.Top), uintptr(r.width()), uintptr(r.height()), flags)
+	}
+	place()
+	current, valid = taskbarWindowRect(w.hwnd)
+	if !valid || current != r {
+		// Crossing monitors sends WM_DPICHANGED synchronously. MyGo accepts
+		// its suggested bounds, which may scale these already physical bounds
+		// a second time. The DPI is now settled; place once more at the exact
+		// safe rectangle, and never reveal an oversized intermediate window.
+		place()
+		current, valid = taskbarWindowRect(w.hwnd)
+	}
+	if !valid || current != r {
+		w.hideSnapPreview()
+		w.win.Hide()
+		return
+	}
+	if !w.win.IsVisible() {
+		w.win.ShowInactive()
+	}
+	w.win.Invalidate()
+}
+
+func taskbarWindowRect(hwnd uintptr) (taskbarRect, bool) {
+	var r taskbarRect
+	ok, _, _ := taskbarGetRect.Call(hwnd, uintptr(unsafe.Pointer(&r)))
+	return r, ok != 0 && r.valid()
+}
+
+func taskbarWindowClass(hwnd uintptr) string {
+	var name [256]uint16
+	n, _, _ := taskbarGetClass.Call(hwnd, uintptr(unsafe.Pointer(&name[0])), uintptr(len(name)))
+	return windows.UTF16ToString(name[:min(int(n), len(name))])
+}
+
+func taskbarWindowShown(hwnd uintptr) bool {
+	visible, _, _ := taskbarVisible.Call(hwnd)
+	if visible == 0 {
+		return false
+	}
+	// A window on another virtual desktop remains WS_VISIBLE but is cloaked.
+	var cloaked uint32
+	hr, _, _ := taskbarGetDWMAttribute.Call(hwnd, 14, uintptr(unsafe.Pointer(&cloaked)), 4)
+	return int32(hr) < 0 || cloaked == 0
+}
