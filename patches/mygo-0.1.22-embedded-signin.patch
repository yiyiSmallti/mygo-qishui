new file mode 100644
--- /dev/null
+++ b/internal/plugin/websignin_scripts.go
@@ -0,0 +1,74 @@
+package plugin
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/MoeForge/moejs/webapi"
+)
+
+// WebSignInError identifies a local window outcome without treating it as an
+// account failure. It carries no challenge URL, cookies or native stack trace.
+type WebSignInError struct{ Code, Message string }
+
+func (e *WebSignInError) Error() string { return e.Message }
+
+func (p *Plugin) prepareSignInScripts(o *WebSignIn) error {
+	if len(o.ScriptFiles) == 0 {
+		return nil
+	}
+	if len(o.ScriptFiles) > 8 {
+		return errors.New("too many sign-in scripts")
+	}
+	page, err := url.Parse(o.URL)
+	if err != nil || page.User != nil {
+		return errors.New("invalid scripted sign-in URL")
+	}
+	cookies, _ := url.Parse(o.CookiesOf)
+	if page.Scheme != cookies.Scheme || !strings.EqualFold(page.Host, cookies.Host) {
+		return errors.New("scripted sign-in must own its cookie origin")
+	}
+	if err := webapi.AllowHosts(p.manifest.Permissions.Network...)(&http.Request{URL: page}); err != nil {
+		return errors.New("scripted sign-in needs permission for its page origin")
+	}
+	data, err := json.Marshal(o.ScriptData)
+	if err != nil || len(data) > 65536 {
+		return errors.New("invalid sign-in script data")
+	}
+	root, err := os.OpenRoot(p.dir)
+	if err != nil {
+		return errors.New("can't read sign-in scripts")
+	}
+	defer root.Close()
+	var script bytes.Buffer
+	origin := page.Scheme + "://" + strings.TrimSuffix(strings.ToLower(page.Host), ":443")
+	originJSON, _ := json.Marshal(origin)
+	fmt.Fprintf(&script, "if(location.origin===%s){window.__mygoSignInData=%s;\n", originJSON, data)
+	for _, name := range o.ScriptFiles {
+		if !filepath.IsLocal(name) || filepath.Ext(name) != ".js" {
+			return errors.New("sign-in scripts must be local JavaScript files")
+		}
+		f, err := root.Open(name)
+		if err != nil {
+			return fmt.Errorf("can't read sign-in script %q", name)
+		}
+		content, readErr := io.ReadAll(io.LimitReader(f, 524289))
+		f.Close()
+		if readErr != nil || script.Len()+len(content) > 524288 {
+			return errors.New("sign-in scripts are too large")
+		}
+		script.Write(content)
+		script.WriteString("\n;\n")
+	}
+	script.WriteString("\n}")
+	o.PreloadScript, o.ScriptOrigin = script.String(), origin
+	return nil
+}
